# --- Base de datos (Neon / Netlify DB) ---
# DATABASE_URL la usan las APIs de /admin y el snapshot del blog (prebuild).
# DATABASE_URL_UNPOOLED se usa en scripts de mantenimiento y migraciones.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Sesiones de /admin ---
# 32+ bytes aleatorios:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Correo del formulario de contacto (OquMail SMTP) ---
# SMTP_USER debe ser el buzón completo; SMTP_PASS es la contraseña del webmail.
SMTP_USER=contacto@proacademymx.com
SMTP_PASS=
CONTACT_TO=contacto@proacademymx.com

# --- Publicación del sitio estático ---
# Build Hook de Netlify (Site configuration > Build & deploy > Build hooks).
# Lo usa el botón "Publicar cambios al sitio" de /admin y el rebuild del blog.
# En local es opcional: sin él, ese botón responde con error de configuración.
NETLIFY_BUILD_HOOK_URL=

# --- Analítica / marketing (opcional) ---
# Son variables PUBLIC_*: se incrustan en el build. Si quedan vacías, los
# componentes de analítica no renderizan nada.
# Ojo: GA4 ya está fijo en src/layouts/Base.astro (G-VVYB14H9ZQ). Deja
# PUBLIC_GA4_ID vacío para no enviar dos veces la página vista.
PUBLIC_GA4_ID=
PUBLIC_GTM_ID=
PUBLIC_CLARITY_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_LINKEDIN_PARTNER_ID=
