# OquMail SMTP credentials used by /api/contact.ts to send contact-form leads.
# SMTP_USER must be the full mailbox address; SMTP_PASS is the OquMail webmail password.
SMTP_USER=contacto@proacademymx.com
SMTP_PASS=

# Blog database (Neon Postgres). Set this in the hosting panel's
# environment-variables section (Neubox), not via `vercel env pull`.
# Use the Neon *test* branch for the staging deployment.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Admin panel (/admin) auth.
# SESSION_SECRET: random 32+ byte secret used to sign session cookies.
# ADMIN_PASSWORD_HASH: bcrypt hash of the admin password (never store the
# plaintext password anywhere). Generate both with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
SESSION_SECRET=
ADMIN_PASSWORD_HASH=

# Admin-uploaded images are stored in Netlify Blobs (see src/lib/storage.ts),
# so no filesystem path is needed. UPLOAD_DIR is intentionally not used.
