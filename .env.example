# OquMail SMTP credentials used by /api/contact.ts to send contact-form leads.
# SMTP_USER must be the full mailbox address; SMTP_PASS is the OquMail webmail password.
SMTP_USER=contacto@proacademymx.com
SMTP_PASS=

# GitHub OAuth App used by the Decap CMS editor at /admin (src/pages/api/decap/*)
# so it can commit blog posts straight to this repo. Create the app at
# https://github.com/settings/developers — Authorization callback URL must be
# https://www.proacademymx.com/api/decap/callback
DECAP_GITHUB_CLIENT_ID=
DECAP_GITHUB_CLIENT_SECRET=
