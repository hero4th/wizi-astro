---
interface Props {
  label?: string;
  href?: string;
}
const { label = "Evaluación gratis", href = "/contacto" } = Astro.props;
---

<div
  id="sticky-cta"
  class="pointer-events-none fixed inset-x-0 bottom-0 z-40 translate-y-full pb-5 transition-transform duration-700 ease-[var(--ease-out-expo)]"
>
  <div class="container-edge flex justify-center">
    <div class="glass pointer-events-auto flex items-center gap-4 rounded-full py-2 pl-6 pr-2 shadow-panel">
      <p class="hidden text-sm text-ink-600 sm:block">
        Cupos limitados, inscripciones abiertas
      </p>
      <span class="hidden size-1 rounded-full bg-teal-400 sm:block" aria-hidden="true"></span>
      <a href={href} class="btn-primary !px-5 !py-2.5 !text-[11px]" data-event="sticky_cta_click">
        {label}
      </a>
    </div>
  </div>
</div>

<style>
  #sticky-cta.is-visible {
    transform: translateY(0);
  }
</style>
