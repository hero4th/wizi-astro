---
import { Icon } from "astro-icon/components";
import { SITE } from "@/data/site";

const message = encodeURIComponent(
  "Hola, quiero información sobre los cursos de Professional Academy."
);
---

<a
  href={`https://wa.me/${SITE.whatsapp}?text=${message}`}
  target="_blank"
  rel="noopener noreferrer"
  class="group fixed bottom-6 right-6 z-50 flex items-center gap-0 rounded-full bg-teal-500 p-3.5 text-ink-950 shadow-glow transition-all duration-500 hover:bg-teal-400 hover:pr-5"
  aria-label="Escríbenos por WhatsApp"
  data-event="whatsapp_click"
>
  <Icon name="simple-icons:whatsapp" class="size-6" aria-hidden="true" />
  <span class="max-w-0 overflow-hidden font-mono text-xs font-medium tracking-wider whitespace-nowrap uppercase transition-all duration-500 group-hover:ml-2.5 group-hover:max-w-40">
    Escríbenos
  </span>
</a>
