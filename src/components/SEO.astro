---
import { SITE } from "@/data/site";
import { jsonLd, organizationSchema, websiteSchema } from "@/lib/schema";

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD nodes appended to the @graph (org + website are always included). */
  schema?: object[];
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  /** Overrides the self-referencing canonical (e.g. content republished from elsewhere). */
  canonicalUrl?: string;
  keywords?: string;
}

const {
  title,
  description,
  schema = [],
  ogImage = "/og-default.png",
  ogType = "website",
  noindex = false,
  canonicalUrl,
  keywords,
} = Astro.props;

const canonical = normalizeCanonical(canonicalUrl ?? Astro.url.pathname);
const ogImageAbs = new URL(ogImage, Astro.site).href;
const graph = jsonLd(organizationSchema(), websiteSchema(), ...schema);

/** Canonicals must be unique: apex host, no query/hash and no trailing slash. */
function normalizeCanonical(value: string): string {
  const url = new URL(value, Astro.site);
  if (/(^|\.)proacademymx\.com$/i.test(url.hostname)) {
    const site = new URL(SITE.url);
    url.protocol = site.protocol;
    url.host = site.host;
  }
  if (url.pathname !== "/") url.pathname = url.pathname.replace(/\/+$/, "");
  url.search = "";
  url.hash = "";
  return url.href;
}
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{keywords && <meta name="keywords" content={keywords} />}
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageAbs} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageAbs} />

<script is:inline type="application/ld+json" set:html={graph} />
