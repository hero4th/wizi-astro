---
const steps = [
  {
    n: "01",
    title: "Diagnóstico",
    detail:
      "Evaluación gratuita bajo condiciones reales de examen. Medimos tu punto de partida exacto, sección por sección.",
  },
  {
    n: "02",
    title: "Plan personalizado",
    detail:
      "Diseñamos tu ruta de estudio día a día: solo los temas que necesitas, en el horario que tú eliges.",
  },
  {
    n: "03",
    title: "Entrenamiento",
    detail:
      "Tutorías 1 a 1 con expertos certificados, materiales oficiales y retroalimentación individual cada semana.",
  },
  {
    n: "04",
    title: "Simulaciones",
    detail:
      "Seis evaluaciones completas idénticas al examen real, con reporte de desempeño por tipo de pregunta.",
  },
  {
    n: "05",
    title: "Resultados",
    detail:
      "Llegas al examen con el puntaje ensayado, no esperado. Garantía de aumento mínimo o devolución del 100%.",
  },
];
---

<section class="relative py-28">
  <div class="container-edge">
    <div class="grid gap-16 lg:grid-cols-[1fr_1.6fr]">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <h2 class="text-4xl sm:text-5xl" data-reveal>
          Cinco pasos.<br />
          <em class="accent-em">Cero improvisación.</em>
        </h2>
        <p class="mt-6 max-w-sm text-sm leading-relaxed text-ink-300" data-reveal>
          La misma metodología certificada que ha llevado a más de 10,000
          estudiantes a su puntaje objetivo, aplicada a tu caso particular.
        </p>
        <a href="/contacto" class="btn-primary mt-9" data-magnetic data-reveal>
          Evaluación gratis
        </a>
      </div>

      <ol class="relative">
        <!-- Línea de progreso vertical -->
        <div class="absolute top-0 bottom-0 left-[1.4rem] w-px bg-pearl/8" aria-hidden="true">
          <div data-method-line class="h-full w-full origin-top scale-y-0 bg-teal-400"></div>
        </div>

        {steps.map((step, i) => (
          <li class="relative flex gap-8 pb-14 pl-0 last:pb-0" data-reveal data-reveal-delay={String(i * 0.06)}>
            <span class="z-10 grid size-12 shrink-0 place-items-center rounded-full bg-ink-900 font-mono text-xs text-teal-400 hairline">
              {step.n}
            </span>
            <div class="pt-2">
              <h3 class="font-display text-2xl font-semibold tracking-tight">{step.title}</h3>
              <p class="mt-2.5 max-w-md text-[15px] leading-relaxed text-ink-300">{step.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  // La línea de la metodología crece en vertical mientras la lista avanza.
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const line = document.querySelector<HTMLElement>("[data-method-line]");
    const list = line?.closest("ol");
    if (line && list) {
      gsap.fromTo(
        line,
        { scaleY: 0 },
        {
          scaleY: 1,
          transformOrigin: "top center",
          ease: "none",
          scrollTrigger: { trigger: list, start: "top 70%", end: "bottom 65%", scrub: 0.7 },
        }
      );
    }
  }
</script>
