---
import { Icon } from "astro-icon/components";

const steps = [
  {
    title: "Diagnóstico",
    detail:
      "Evaluación gratuita bajo condiciones reales de examen. Medimos tu punto de partida exacto, sección por sección.",
    icon: "line-md:search",
  },
  {
    title: "Plan personalizado",
    detail:
      "Diseñamos tu ruta de estudio día a día: solo los temas que necesitas, en el horario que tú eliges.",
    icon: "line-md:clipboard-list",
  },
  {
    title: "Entrenamiento",
    detail:
      "Tutorías 1 a 1 con expertos certificados, materiales oficiales y retroalimentación individual cada semana.",
    icon: "line-md:monitor-arrow-down-twotone",
  },
  {
    title: "Simulaciones",
    detail:
      "Seis evaluaciones completas idénticas al examen real, con reporte de desempeño por tipo de pregunta.",
    icon: "line-md:pencil",
  },
  {
    title: "Resultados",
    detail:
      "Llegas al examen con el puntaje ensayado, no esperado. Garantía de aumento mínimo o devolución del 100%.",
    icon: "line-md:check-list-3",
  },
];
---

<section class="relative py-28" aria-label="Metodología" data-method-section>
  <div class="container-edge">
    <div class="grid items-stretch gap-12 lg:grid-cols-[0.92fr_1.08fr] lg:gap-16">

      <!-- Izquierda: imagen a toda la altura, con título superpuesto -->
      <div class="lg:h-full" data-reveal>
        <div class="relative min-h-[26rem] overflow-hidden rounded-3xl bg-ink-900 shadow-panel lg:h-full">
          <img
            src="/images/study-plan.webp"
            alt="Estudiante planeando su preparación en la biblioteca"
            width="1000"
            height="1000"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 size-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-b from-ink-950/90 via-ink-950/35 to-ink-950/5" aria-hidden="true"></div>
          <div class="relative p-7 sm:p-9">
            <p class="eyebrow !text-teal-300">Metodología</p>
            <h2 class="mt-3 font-display text-[clamp(2rem,3.4vw,2.75rem)] font-semibold leading-[1.04] tracking-tight text-pearl">
              Planea tu estudio<br />
              <em class="font-display italic font-medium text-teal-300">cero improvisación.</em>
            </h2>
            <p class="mt-5 max-w-xs text-sm leading-relaxed text-pearl-dim">
              La misma metodología certificada que ha llevado a más de 10,000
              estudiantes a su puntaje objetivo, aplicada a tu caso particular.
            </p>
          </div>
        </div>
      </div>

      <!-- Derecha: pasos -->
      <ol class="relative pt-2">
        <!-- Línea de progreso vertical -->
        <div class="absolute top-2 bottom-10 left-[1.6rem] w-px bg-ink-950/8" aria-hidden="true">
          <div data-method-line class="h-full w-full origin-top scale-y-0 bg-teal-500"></div>
        </div>

        {steps.map((step, i) => (
          <li
            class="group relative flex gap-6 pb-12 last:pb-0"
            data-method-step
            data-reveal
          >
            <span
              class="relative z-10 grid size-[3.25rem] shrink-0 place-items-center rounded-full bg-ink-950 text-teal-400 transition-all duration-500 group-has-[[data-method-trigger]:hover]:scale-110 group-has-[[data-method-trigger]:hover]:ring-2 group-has-[[data-method-trigger]:hover]:ring-teal-500/40 hairline-dim"
              data-method-icon
              data-method-trigger
            >
              <Icon name={step.icon} class="size-6" aria-hidden="true" />
            </span>
            <div class="pt-2.5">
              <h3 data-method-trigger class="w-fit font-display text-xl font-semibold tracking-tight text-ink-950 sm:text-2xl">
                {step.title}
              </h3>
              <p class="mt-2.5 max-w-md text-[15px] leading-relaxed text-ink-600">{step.detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Línea de progreso
  if (!reduced) {
    const line = document.querySelector<HTMLElement>("[data-method-line]");
    const list = line?.closest("ol");
    if (line && list) {
      gsap.fromTo(
        line,
        { scaleY: 0 },
        {
          scaleY: 1,
          transformOrigin: "top center",
          ease: "none",
          scrollTrigger: { trigger: list, start: "top 70%", end: "bottom 70%", scrub: 0.7 },
        }
      );
    }
  }

  // Animación de iconos line-md: se reproduce al pasar el cursor por el icono o el título.
  function replayIcon(span: Element | null) {
    span
      ?.querySelectorAll("animate, animateTransform, animateMotion, set")
      .forEach((a) => {
        try {
          (a as SVGAnimationElement).beginElement();
        } catch {}
      });
  }

  function initMethodIcons() {
    // Solo el icono y el título disparan la animación, no el párrafo.
    document.querySelectorAll("[data-method-trigger]").forEach((el) => {
      el.addEventListener("mouseenter", () =>
        replayIcon(el.closest("[data-method-step]")?.querySelector("[data-method-icon]") ?? null)
      );
    });
  }

  initMethodIcons();
  document.addEventListener("astro:page-load", initMethodIcons);
</script>
