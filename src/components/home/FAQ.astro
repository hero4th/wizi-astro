---
import FAQList from "@/components/FAQList.astro";
import { FAQS } from "@/data/faqs";

// En la home solo van las preguntas que más influyen en la decisión.
const featured = FAQS.filter((f) =>
  [
    "¿Qué es Professional Academy?",
    "¿En qué consiste la Garantía de Satisfacción Total?",
    "¿Puedo pagar a plazos?",
    "¿Las clases son individuales o grupales?",
    "¿Ofrecen una evaluación gratis?",
    "¿Puedo elegir mis horarios?",
  ].includes(f.q)
);
---

<section
  class="relative overflow-hidden py-28 hairline-t-dim"
  style="background-color: rgb(8 13 13)"
  aria-label="Preguntas frecuentes"
>
  <!-- Halo decorativo -->
  <div class="pointer-events-none absolute -right-32 top-1/3 h-[30rem] w-[30rem] rounded-full bg-teal-500/8 blur-[120px]" aria-hidden="true"></div>

  <div class="container-edge relative grid gap-14 lg:grid-cols-[1fr_1.6fr]">
    <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
      <p class="eyebrow !text-teal-400">Soporte</p>
      <h2 class="mt-4 text-4xl text-pearl sm:text-5xl">
        Resolvemos<br /><em class="font-display italic font-medium text-teal-400">tus dudas.</em>
      </h2>
      <p class="mt-6 max-w-sm text-sm leading-relaxed text-ink-300">
        Las respuestas que más nos piden antes de inscribirse. Si tu pregunta
        no está aquí, ponte en contacto con nosotros.
      </p>
      <a href="/preguntas-frecuentes" class="mt-9 inline-flex min-w-[240px] items-center justify-center rounded-full bg-teal-400 px-12 py-3.5 font-display text-[13px] font-bold tracking-widest text-ink-950 transition-colors hover:bg-teal-300 uppercase" data-magnetic>
        CONOCER MÁS
      </a>
    </div>

    <div data-reveal>
      <FAQList faqs={featured} name="faq-home" variant="dark" />
    </div>
  </div>
</section>
