---
import { TESTIMONIALS } from "@/data/testimonials";
---

<section class="relative overflow-hidden py-28" aria-label="Testimonios de alumnos">
  <div class="container-edge">
    <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div>
        <p class="eyebrow">Casos de éxito</p>
        <h2 class="mt-4 max-w-xl text-4xl sm:text-5xl">
          Ellos ya lograron <em class="accent-em">su meta.</em>
        </h2>
      </div>
      <div class="flex gap-3">
        <button
          class="t-prev grid size-12 place-items-center rounded-full hairline text-ink-500 transition-colors hover:border-teal-500 hover:text-teal-600"
          aria-label="Testimonio anterior"
        >
          <svg class="size-4 rotate-180" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M1 8h14m0 0L9 2m6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button
          class="t-next grid size-12 place-items-center rounded-full hairline text-ink-500 transition-colors hover:border-teal-500 hover:text-teal-600"
          aria-label="Siguiente testimonio"
        >
          <svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M1 8h14m0 0L9 2m6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- El carrusel sangra fuera del contenedor a la derecha -->
  <div class="mt-14 pl-[max(1.25rem,calc((100vw-80rem)/2+2.5rem))]" data-reveal>
    <div class="swiper testimonial-swiper overflow-visible!">
      <div class="swiper-wrapper">
        {TESTIMONIALS.map((t) => (
          <button
            type="button"
            class="testimonial-card group swiper-slide flex h-auto! w-[22rem]! cursor-pointer flex-col rounded-3xl border border-ink-950/[0.06] bg-ink-50 p-8 text-left transition-all duration-300 hover:-translate-y-1 hover:border-teal-500/30 hover:bg-white hover:shadow-card-lg sm:w-[27rem]!"
            data-testimonial
            data-name={t.name}
            data-course={`Curso ${t.program}`}
            data-score={t.score}
            data-image={t.image}
            data-quote={t.fullQuote ?? t.quote}
            aria-haspopup="dialog"
            aria-label={`Leer testimonio de ${t.name}`}
          >
            <div class="flex items-center justify-between gap-3">
              <div class="flex items-center gap-3.5">
                <img
                  src={t.image}
                  alt={t.name}
                  width="64"
                  height="64"
                  loading="lazy"
                  decoding="async"
                  class="size-16 shrink-0 rounded-full object-cover ring-2 ring-white"
                />
                <div>
                  <p class="font-display text-lg font-semibold tracking-tight text-ink-950">{t.name}</p>
                  <p class="mt-0.5 font-mono text-[10px] tracking-[0.16em] text-teal-600 uppercase">
                    Curso {t.program}
                  </p>
                </div>
              </div>
              <span class="grid size-9 shrink-0 place-items-center rounded-full bg-teal-500/12 text-teal-600 transition-colors group-hover:bg-teal-500 group-hover:text-ink-950" aria-hidden="true">
                <svg class="size-4" viewBox="0 0 16 16" fill="none">
                  <path d="M3 13 13 3m0 0H5m8 0v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </div>
            <blockquote class="mt-6 line-clamp-5 flex-1 text-base leading-relaxed text-ink-600">
              “{t.quote}”
            </blockquote>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- Modal de testimonio -->
<div
  id="tm-modal"
  class="fixed inset-0 z-[110] flex items-center justify-center p-4 opacity-0 invisible transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="tm-name"
  aria-hidden="true"
>
  <div class="tm-backdrop absolute inset-0 bg-ink-950/70 backdrop-blur-sm" data-tm-close></div>
  <div class="tm-panel relative w-full max-w-2xl scale-95 rounded-3xl bg-white p-7 shadow-panel transition-transform duration-300 sm:p-10">
    <button
      type="button"
      class="absolute right-5 top-5 grid size-9 place-items-center rounded-full bg-teal-500/12 text-ink-700 transition-colors hover:bg-teal-500 hover:text-ink-950"
      aria-label="Cerrar"
      data-tm-close
    >
      <svg class="size-4" viewBox="0 0 16 16" fill="none">
        <path d="M3 3l10 10M13 3 3 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </button>

    <div class="flex flex-wrap items-center gap-4 pr-10">
      <img id="tm-img" src="" alt="" width="56" height="56" class="size-14 rounded-full object-cover" />
      <div class="mr-2">
        <p id="tm-name" class="font-display text-xl font-semibold tracking-tight text-ink-950"></p>
        <p id="tm-course" class="font-mono text-[10px] tracking-[0.16em] text-teal-600 uppercase"></p>
      </div>
      <span class="inline-flex items-center gap-2 rounded-full bg-teal-500/12 px-3.5 py-1.5 font-mono text-[11px] tracking-wide text-teal-800 uppercase">
        <svg class="size-3.5 text-teal-600" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="m3.5 8.5 3 3 6-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Puntaje <span id="tm-score" class="text-teal-900"></span>
      </span>
    </div>

    <div id="tm-body" class="mt-6 max-h-[55vh] space-y-4 overflow-y-auto pr-1 text-[15px] leading-relaxed text-ink-600"></div>
  </div>
</div>

<script>
  import Swiper from "swiper";
  import { Navigation, A11y, Autoplay, FreeMode } from "swiper/modules";
  import "swiper/css";

  function initCarousel() {
    const swiperEl = document.querySelector(".testimonial-swiper");
    if (!swiperEl) return;
    if ((swiperEl as any).swiper) (swiperEl as any).swiper.destroy(true, true);

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    new Swiper(".testimonial-swiper", {
      modules: [Navigation, A11y, Autoplay, FreeMode],
      slidesPerView: "auto",
      spaceBetween: 24,
      grabCursor: true,
      loop: true,
      a11y: { enabled: true },
      navigation: { nextEl: ".t-next", prevEl: ".t-prev" },
      autoplay: reduced ? false : { delay: 0, disableOnInteraction: false, pauseOnMouseEnter: true },
      speed: reduced ? 600 : 4500,
      freeMode: reduced ? false : { enabled: true, momentum: false },
    });
  }

  function initModal() {
    const modal = document.getElementById("tm-modal");
    if (!modal || modal.dataset.bound) return;
    modal.dataset.bound = "true";
    const panel = modal.querySelector(".tm-panel");
    const img = document.getElementById("tm-img") as HTMLImageElement;
    const nameEl = document.getElementById("tm-name")!;
    const courseEl = document.getElementById("tm-course")!;
    const scoreEl = document.getElementById("tm-score")!;
    const body = document.getElementById("tm-body")!;
    let lastFocus: HTMLElement | null = null;

    const open = (card: HTMLElement) => {
      lastFocus = card;
      img.src = card.dataset.image || "";
      img.alt = card.dataset.name || "";
      nameEl.textContent = card.dataset.name || "";
      courseEl.textContent = card.dataset.course || "";
      scoreEl.textContent = card.dataset.score || "";
      body.innerHTML = "";
      const paras = (card.dataset.quote || "").split(/\n{2,}/).map((s) => s.trim()).filter(Boolean);
      paras.forEach((para, idx) => {
        const p = document.createElement("p");
        let text = para;
        if (idx === 0) text = "“" + text;
        if (idx === paras.length - 1) text = text + "”";
        p.textContent = text;
        body.appendChild(p);
      });
      modal.classList.remove("invisible", "opacity-0");
      modal.setAttribute("aria-hidden", "false");
      panel?.classList.remove("scale-95");
      document.documentElement.classList.add("lenis-stopped");
      (modal.querySelector("[data-tm-close]") as HTMLElement)?.focus();
    };

    const close = () => {
      modal.classList.add("invisible", "opacity-0");
      modal.setAttribute("aria-hidden", "true");
      panel?.classList.add("scale-95");
      document.documentElement.classList.remove("lenis-stopped");
      lastFocus?.focus();
    };

    document.querySelectorAll<HTMLElement>("[data-testimonial]").forEach((card) => {
      card.addEventListener("click", () => open(card));
    });
    modal.querySelectorAll("[data-tm-close]").forEach((el) => el.addEventListener("click", close));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal.getAttribute("aria-hidden") === "false") close();
    });
  }

  function init() {
    initCarousel();
    initModal();
  }

  document.addEventListener("astro:page-load", init);
  if (document.readyState === "complete" || document.readyState === "interactive") setTimeout(init, 0);
  else document.addEventListener("DOMContentLoaded", init);
</script>

<style is:global>
  .testimonial-swiper .swiper-wrapper {
    transition-timing-function: linear !important;
  }
  #tm-modal[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
  }
</style>
