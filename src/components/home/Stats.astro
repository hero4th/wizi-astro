---
import { METRICS } from "@/data/site";
---

<section class="relative py-28" aria-label="Resultados">
  <div class="container-edge">
    <div class="grid items-center gap-10 lg:grid-cols-[1.3fr_0.7fr]">
      <div data-reveal>
        <h2 class="text-4xl sm:text-5xl text-ink-950">
          Garantizamos <em class="accent-em">resultados reales.</em>
        </h2>
        <p class="mt-5 max-w-lg text-base leading-relaxed text-ink-600">
          Cada programa de estudio mide tu nivel y está diseñado para que mejores
          en poco tiempo. Sin promesas vagas: puntos reales, verificables y
          garantizados.
        </p>
      </div>

      <!-- Animación Lottie: mano escribiendo (sin data-reveal: el transform de
           GSAP aislaría el contexto de mezcla y reaparecería el fondo blanco) -->
      <div class="flex justify-center lg:justify-end">
        <img
          src="/images/animation-home.gif"
          class="w-full max-w-[20rem] aspect-square object-contain mix-blend-multiply"
          alt="Animación de una mano escribiendo en una hoja de examen"
        />
      </div>
    </div>

    <div class="mt-16 grid grid-cols-2 lg:grid-cols-4">
      {METRICS.map((m, i) => (
        <div
          class:list={[
            "group relative px-6 py-10 transition-colors duration-500 hover:bg-teal-500/4",
            i > 0 && "border-l border-ink-950/8",
            i >= 2 && "max-lg:border-t max-lg:border-ink-950/8",
            i === 2 && "max-lg:border-l-0",
          ]}
          data-reveal
        >
          <p class="font-display text-5xl font-semibold tracking-tight text-teal-600 sm:text-6xl">
            <span class="text-teal-500">{m.prefix}</span><span
              data-counter={String(m.value)}
              data-decimals={"decimals" in m ? String(m.decimals) : "0"}
            >0</span><span class="text-2xl text-ink-400 sm:text-3xl">{m.suffix}</span>
          </p>
          <p class="mt-3 font-mono text-[11px] tracking-[0.18em] text-ink-500 uppercase">
            {m.label}
          </p>
          <div class="absolute inset-x-6 bottom-0 h-px scale-x-0 bg-teal-500/50 transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-x-100" aria-hidden="true"></div>
        </div>
      ))}
    </div>
  </div>
</section>
