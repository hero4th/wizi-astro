---
import { METRICS } from "@/data/site";
---

<section class="relative py-28" aria-label="Resultados">
  <div class="container-edge">
    <div class="max-w-2xl" data-reveal>
      <h2 class="text-4xl sm:text-5xl">
        Los números <em class="accent-em">hablan primero.</em>
      </h2>
      <p class="mt-5 max-w-lg text-base leading-relaxed text-ink-300">
        Cada programa se mide contra tu diagnóstico inicial. Sin promesas vagas:
        puntos reales, verificables y garantizados por contrato.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-2 lg:grid-cols-4">
      {METRICS.map((m, i) => (
        <div
          class:list={[
            "group relative px-6 py-10 transition-colors duration-500 hover:bg-teal-400/4",
            i > 0 && "border-l border-pearl/8",
            i >= 2 && "max-lg:border-t max-lg:border-pearl/8",
            i === 2 && "max-lg:border-l-0",
          ]}
          data-reveal
          data-reveal-delay={String(i * 0.08)}
        >
          <p class="font-display text-5xl font-semibold tracking-tight text-pearl sm:text-6xl">
            <span class="text-teal-400">{m.prefix}</span><span
              data-counter={String(m.value)}
              data-decimals={"decimals" in m ? String(m.decimals) : "0"}
            >0</span><span class="text-2xl text-ink-400 sm:text-3xl">{m.suffix}</span>
          </p>
          <p class="mt-3 font-mono text-[11px] tracking-[0.18em] text-ink-300 uppercase">
            {m.label}
          </p>
          <div class="absolute inset-x-6 bottom-0 h-px scale-x-0 bg-teal-400/60 transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-x-100" aria-hidden="true"></div>
        </div>
      ))}
    </div>
  </div>
</section>
