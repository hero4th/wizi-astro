---
import { PROGRAMS } from "@/data/programs";
---

<section id="programas" class="relative py-28">
  <div class="container-edge">
    <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div>
        <p class="eyebrow">Programas</p>
        <h2 class="mt-4 max-w-xl text-4xl sm:text-5xl">
          Elige tu examen.<br />
          <em class="accent-em">Nosotros, el camino.</em>
        </h2>
      </div>
      <a href="/precios" class="btn-ghost !px-5 !py-2.5 !text-[11px]" data-magnetic>Comparar precios</a>
    </div>

    <div class="mt-16 hairline-t">
      {PROGRAMS.map((p, i) => (
        <a
          href={`/cursos/${p.slug}`}
          class="group relative grid grid-cols-[1fr_auto] items-center gap-x-6 overflow-hidden py-8 hairline-b transition-colors duration-500 sm:grid-cols-[1.2fr_1fr_auto] sm:gap-x-10"
          data-reveal
          data-reveal-delay={String(i * 0.05)}
          data-event="program_row_click"
        >
          <!-- Barrido turquesa al hover -->
          <div class="absolute inset-0 origin-bottom scale-y-0 bg-teal-400/5 transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:scale-y-100" aria-hidden="true"></div>

          <div class="relative">
            <h3 class="font-display text-3xl font-semibold tracking-tight transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:translate-x-2 sm:text-5xl">
              {p.exam}
            </h3>
            <p class="mt-1.5 font-mono text-[10px] tracking-[0.18em] text-ink-400 uppercase">
              {p.fullName}
            </p>
          </div>

          <p class="relative hidden text-sm leading-relaxed text-ink-300 sm:block">
            {p.audience}
          </p>

          <span class="relative grid size-12 place-items-center rounded-full hairline transition-all duration-500 group-hover:border-teal-400 group-hover:bg-teal-400 group-hover:text-ink-950">
            <svg class="size-4 transition-transform duration-500 group-hover:rotate-[-35deg]" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M1 8h14m0 0L9 2m6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
