---
import { SITE } from "@/data/site";
import InteractiveImageAccordion from "@/components/ui/InteractiveImageAccordion.astro";
---

<section class="relative flex min-h-[88svh] items-center overflow-hidden hairline-t-dim" style="background-color: rgb(6 10 10)" aria-label="Comienza tu preparación">
  <div class="container-edge relative z-10 py-24">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-16 lg:gap-10">
      
      <!-- Left Side: Text Content -->
      <div class="w-full lg:w-[45%] text-center lg:text-left">
        <h2
          class="font-display text-[clamp(2.5rem,5vw,4.25rem)] leading-[1.04] font-semibold tracking-[-0.03em] text-pearl"
          data-reveal-line
        >
          <span class="line-mask"><span class="line-inner">El puntaje que necesitas</span></span>
          <span class="line-mask"><span class="line-inner"><em class="accent-em">ya tiene fecha.</em></span></span>
        </h2>

        <p class="mt-8 text-lg leading-relaxed text-ink-300 max-w-xl mx-auto lg:mx-0" data-reveal>
          Tu primera evaluación es gratuita: mide tu nivel, conoce tu plan y
          decide con datos.
        </p>

        <div class="mt-11 flex flex-wrap items-center justify-center lg:justify-start gap-4" data-reveal>
          <a href="/contacto" class="btn-primary !px-9 !py-4.5" data-magnetic data-event="final_cta_click">
            Evaluación gratis
          </a>
          <a
            href={`https://wa.me/${SITE.whatsapp}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost-dark"
            data-magnetic
          >
            Hablar por WhatsApp
          </a>
        </div>

        <p class="mt-10 font-mono text-[11px] tracking-[0.22em] text-ink-300 uppercase" data-reveal>
          Sin compromiso. Resultados en la primera sesión.
        </p>
      </div>

      <!-- Right Side: Image Accordion -->
      <div class="w-full lg:w-[55%] flex justify-end">
        <InteractiveImageAccordion />
      </div>

    </div>
  </div>
</section>
