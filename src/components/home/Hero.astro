---
// Hero — Carrusel fotorrealista premium
// Izquierda: copy + CTAs. Derecha: formulario.
import HeroBackgroundCarousel from "@/components/react/HeroBackgroundCarousel.tsx";
---

<section
  id="hero"
  class="relative flex min-h-[100dvh] items-center overflow-hidden"
>
  <HeroBackgroundCarousel client:load />

  <!-- Contenido -->
  <div class="container-edge relative z-10 pt-24 pb-20">
    <div class="grid items-center gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">

      <!-- Columna izquierda: Copy -->
      <div>
        <p class="hero-fade flex items-center gap-2.5 font-mono text-[11px] tracking-[0.22em] text-teal-300 uppercase">
          <span class="relative flex size-2" aria-hidden="true">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-teal-400 opacity-60"></span>
            <span class="relative inline-flex size-2 rounded-full bg-teal-400"></span>
          </span>
          Inscripciones abiertas
        </p>

        <h1
          class="mt-6 max-w-2xl font-display text-[clamp(2.75rem,6.5vw,5.25rem)] leading-[1.04] font-semibold tracking-[-0.03em] text-white"
          data-reveal-line
        >
          <span class="line-mask"><span class="line-inner">Tu examen es solo</span></span>
          <span class="line-mask"><span class="line-inner">el <em class="text-teal-400 italic">comienzo.</em></span></span>
        </h1>

        <p class="hero-fade mt-7 max-w-[38rem] text-[1.0625rem] leading-relaxed text-pearl-dim">
          Entrena con expertos certificados y alcanza el puntaje que exigen las
          mejores universidades, con Garantía de Puntaje por contrato.
        </p>

        <div class="hero-fade mt-10 flex flex-wrap items-center gap-4">
          <a href="/contacto" class="btn-primary" data-magnetic data-event="hero_cta_primary">
            Comenzar ahora
            <svg class="size-3.5" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M1 7h12m0 0L8 2m5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a href="#programas" class="btn-ghost !text-white hover:!bg-white/10" data-magnetic>Ver programas</a>
        </div>
      </div>

      <!-- Columna derecha: Formulario de registro -->
      <div class="hero-fade hidden lg:block">
        <div class="rounded-[20px] bg-white p-8 shadow-2xl shadow-ink-900/5 ring-1 ring-ink-950/5">
          <p class="font-display text-[17px] font-semibold leading-snug text-ink-950">
            Regístrate para saber más sobre planes y precios:
          </p>

          <form class="mt-6 space-y-3.5" action="/gracias" method="GET">
            <input type="text" name="nombre" required placeholder="Nombre*" class="w-full rounded border border-ink-200 bg-white px-4 py-3 text-[14px] outline-none transition-colors placeholder:text-ink-400 focus:border-teal-500 focus:ring-1 focus:ring-teal-500" />
            
            <input type="text" name="apellidos" required placeholder="Apellidos*" class="w-full rounded border border-ink-200 bg-white px-4 py-3 text-[14px] outline-none transition-colors placeholder:text-ink-400 focus:border-teal-500 focus:ring-1 focus:ring-teal-500" />

            <input type="email" name="email" required placeholder="Correo Electrónico*" class="w-full rounded border border-ink-200 bg-white px-4 py-3 text-[14px] outline-none transition-colors placeholder:text-ink-400 focus:border-teal-500 focus:ring-1 focus:ring-teal-500" />

            <div class="flex gap-3">
              <select class="w-[88px] shrink-0 rounded border border-ink-200 bg-white px-3 py-3 text-[14px] outline-none transition-colors focus:border-teal-500 focus:ring-1 focus:ring-teal-500">
                <option>+52</option>
                <option>+1</option>
              </select>
              <input type="tel" name="telefono" required placeholder="Número de teléfono*" class="flex-1 rounded border border-ink-200 bg-white px-4 py-3 text-[14px] outline-none transition-colors placeholder:text-ink-400 focus:border-teal-500 focus:ring-1 focus:ring-teal-500" />
            </div>

            <select required class="w-full rounded border border-ink-200 bg-white px-4 py-3 text-[14px] text-ink-400 outline-none transition-colors focus:border-teal-500 focus:ring-1 focus:ring-teal-500">
              <option value="" disabled selected>Edad*</option>
              <option value="15-18">15 a 18 años</option>
              <option value="19-25">19 a 25 años</option>
              <option value="26+">26 años o más</option>
            </select>

            <select required class="w-full rounded border border-ink-200 bg-white px-4 py-3 text-[14px] text-ink-400 outline-none transition-colors focus:border-teal-500 focus:ring-1 focus:ring-teal-500">
              <option value="" disabled selected>Motivación*</option>
              <option value="universidad">Admisión a universidad</option>
              <option value="posgrado">Admisión a posgrado</option>
              <option value="trabajo">Crecimiento profesional</option>
            </select>

            <div class="pt-2 flex items-start gap-3">
              <input type="checkbox" id="privacy" required class="mt-0.5 size-[18px] shrink-0 rounded border-ink-300 text-teal-600 focus:ring-teal-500" />
              <label for="privacy" class="text-[12px] leading-[1.6] text-ink-600">
                Sí, he leído y comprendido cómo Professional Academy procesa mis datos personales tal y como establece la <a href="/politica-de-privacidad" class="font-semibold text-ink-950 underline hover:text-teal-600">política de privacidad</a>. *
              </label>
            </div>

            <div class="pt-1">
              <button type="submit" class="w-auto rounded-lg bg-teal-600 px-8 py-3 text-[14px] font-medium text-white transition-colors hover:bg-teal-700">
                Enviar
              </button>
            </div>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import gsap from "gsap";

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const tl = gsap.timeline({ defaults: { ease: "expo.out" } });
    tl.to("#hero [data-reveal-line] .line-inner", {
      y: 0,
      duration: 1.3,
      stagger: 0.12,
      delay: 0.15,
    }).fromTo(
      "#hero .hero-fade",
      { opacity: 0, y: 24 },
      { opacity: 1, y: 0, duration: 1, stagger: 0.08 },
      "-=0.9"
    );
  } else {
    document.querySelectorAll<HTMLElement>("#hero .hero-fade").forEach((el) => {
      el.style.opacity = "1";
    });
  }
</script>

<style>
  .hero-fade {
    opacity: 0;
  }
  html.no-motion .hero-fade {
    opacity: 1;
  }
</style>
