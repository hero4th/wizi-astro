---
// Hero — Pantalla completa fotorrealista premium.
// Copy a la izquierda + selector de examen. La foto ocupa todo el lienzo.
import HeroBackgroundCarousel from "@/components/react/HeroBackgroundCarousel.tsx";

const EXAMS = [
  { label: "TOEFL iBT", slug: "toefl-ibt" },
  { label: "SAT", slug: "sat" },
  { label: "PAA", slug: "paa" },
  { label: "GMAT", slug: "gmat" },
  { label: "GRE", slug: "gre" },
];
---

<section
  id="hero"
  class="relative flex min-h-[100dvh] items-center overflow-hidden"
>
  <HeroBackgroundCarousel client:load />

  <!-- Contenido -->
  <div class="container-edge relative z-10 pt-32 pb-24 sm:pt-28">
    <div class="max-w-3xl">
      <p class="hero-fade flex items-center gap-2.5 font-mono text-[11px] tracking-[0.22em] text-teal-300 uppercase">
        <span class="relative flex size-2" aria-hidden="true">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-teal-400 opacity-60"></span>
          <span class="relative inline-flex size-2 rounded-full bg-teal-400"></span>
        </span>
        Inscripciones abiertas
      </p>

      <h1
        class="mt-6 font-display text-[clamp(3rem,8vw,6rem)] leading-[0.98] font-semibold tracking-[-0.035em] text-white"
        data-reveal-line
      >
        <span class="line-mask"><span class="line-inner">Tu examen es</span></span>
        <span class="line-mask"><span class="line-inner"><em class="text-teal-400 italic font-medium">el comienzo.</em></span></span>
      </h1>

      <p class="hero-fade mt-7 max-w-xl text-[1.0625rem] leading-relaxed text-pearl-dim sm:text-lg">
        Entrena con expertos certificados y alcanza el puntaje que exigen las
        mejores universidades, con Garantía de Puntaje por contrato.
      </p>

      <!-- Selector de examen -->
      <div class="hero-fade mt-11">
        <p class="font-mono text-[11px] tracking-[0.24em] text-white uppercase">
          Elige tu examen
        </p>
        <div class="mt-4 flex flex-wrap gap-2.5">
          {EXAMS.map((exam) => (
            <a
              href={`/cursos/${exam.slug}`}
              class="exam-pill group relative inline-flex items-center justify-center rounded-full border border-white/10 bg-[#151515] px-6 py-2.5 font-display text-[15px] font-semibold text-white transition-all duration-300 hover:border-teal-400 hover:bg-teal-400 hover:text-ink-950"
              data-magnetic
              data-event="hero_exam_select"
            >
              <span class="transition-transform duration-300 ease-out group-hover:-translate-x-3">
                {exam.label}
              </span>
              <svg class="absolute right-3.5 size-3.5 translate-x-3 opacity-0 transition-all duration-300 ease-out group-hover:translate-x-0 group-hover:opacity-100" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M1 7h12m0 0L8 2m5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          ))}
        </div>
      </div>

      <div class="hero-fade mt-11 flex flex-wrap items-center gap-x-7 gap-y-4">
        <button type="button" class="btn-primary !font-display !text-[15px] !font-bold uppercase tracking-wider" data-magnetic data-event="hero_cta_primary" data-open-diagnostic>
          Evaluación gratis
          <svg class="size-4" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 7h12m0 0L8 2m5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <span class="flex items-center gap-2.5 font-display text-[14px] font-semibold tracking-wider text-white uppercase">
          <svg class="size-5 text-teal-400" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 1.5 9.9 5.4l4.3.6-3.1 3 .7 4.3L8 11.3 4.2 13.3l.7-4.3-3.1-3 4.3-.6z" fill="currentColor" />
          </svg>
          4.9/5 · +10,000 alumnos
        </span>
      </div>
    </div>
  </div>

</section>

<script>
  import gsap from "gsap";

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const tl = gsap.timeline({ defaults: { ease: "expo.out" } });
    tl.to("#hero [data-reveal-line] .line-inner", {
      y: 0,
      duration: 1.3,
      stagger: 0.12,
      delay: 0.15,
    }).fromTo(
      "#hero .hero-fade",
      { opacity: 0, y: 24 },
      { opacity: 1, y: 0, duration: 1, stagger: 0.08 },
      "-=0.9"
    );
  } else {
    document.querySelectorAll<HTMLElement>("#hero .hero-fade").forEach((el) => {
      el.style.opacity = "1";
    });
  }
</script>

<style>
  .hero-fade {
    opacity: 0;
  }
  html.no-motion .hero-fade {
    opacity: 1;
  }
</style>
