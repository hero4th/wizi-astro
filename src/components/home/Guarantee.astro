---
import { Icon } from "astro-icon/components";

const terms = [
  "Aumento mínimo de 10 puntos sobre tu diagnóstico inicial",
  "Si no lo alcanzas, devolución del 100% de tu inversión",
  "Por escrito, en tu contrato de inscripción",
];
---

<section class="relative py-28" aria-label="Garantía de Puntaje">
  <div class="container-edge">
    <div class="relative overflow-hidden rounded-3xl hairline-dim bg-ink-900 px-6 py-16 sm:px-14 lg:py-20" data-reveal>
      <!-- Glow interno -->
      <div class="pointer-events-none absolute -top-32 right-0 h-96 w-96 rounded-full bg-teal-500/10 blur-[100px]" aria-hidden="true"></div>

      <div class="relative grid items-center gap-12 lg:grid-cols-[1.1fr_1fr]">
        <div>
          <h2 class="font-display max-w-md text-[clamp(2.5rem,5vw,3.5rem)] font-semibold leading-[1.1] tracking-tight text-pearl">
            Tu puntaje sube,<br />
            <em class="font-display italic font-medium text-teal-400 pr-2">o no pagas.</em>
          </h2>
          <p class="mt-6 max-w-md text-base leading-relaxed text-pearl-dim">
            La Garantía de Puntaje es un compromiso contractual, no una frase de
            marketing. Así de seguros estamos de nuestra metodología.
          </p>
          <ul class="mt-8 space-y-4">
            {terms.map((term) => (
              <li class="flex items-start gap-3 text-[15px] text-pearl-dim">
                <Icon name="ph:seal-check" class="mt-0.5 size-5 shrink-0 text-teal-400" aria-hidden="true" />
                {term}
              </li>
            ))}
          </ul>
        </div>

        <!-- El sello: número gigante -->
        <div class="relative text-center lg:text-right" data-parallax="-30" data-parallax-root>
          <p class="font-display text-[clamp(6rem,16vw,11rem)] leading-none font-bold tracking-[-0.04em] text-teal-400 drop-shadow-[0_0_30px_rgba(45,212,191,0.2)]">
            +10
          </p>
          <p class="mt-2 font-mono text-xs tracking-[0.3em] text-pearl-dim uppercase">
            puntos garantizados
          </p>
          <p class="mt-8 inline-block rounded-full hairline-dim bg-ink-950/50 px-6 py-3 font-mono text-[11px] font-medium tracking-widest text-teal-300 uppercase shadow-sm">
            Avalada por +10,000 alumnos
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
