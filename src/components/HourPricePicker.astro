---
import type { HourPackage } from "@/data/hour-packages";

interface Props {
  packages: HourPackage[];
  initialIndex?: number;
  exam: string;
  note: string;
  compact?: boolean;
}
const { packages, initialIndex = 1, exam, note, compact = false } = Astro.props;
const initial = packages[initialIndex];
const formatPrice = (price: number) => `$${price.toLocaleString("en-US")}`;
---

<hour-price-picker
  class:list={[
    "flex w-full items-end justify-between flex-nowrap",
    compact ? "gap-2" : "gap-2 sm:gap-3",
  ]}
  data-packages={JSON.stringify(packages)}
  data-initial-index={initialIndex}
>
  <div class="min-w-0">
    <p class:list={[compact ? "text-[11px] font-semibold text-slate-600 whitespace-nowrap" : "text-[14px] font-medium text-[#475569] whitespace-nowrap"]}>{note}</p>
    <p class="mt-1 font-display tracking-tight whitespace-nowrap text-[#1b2a38]">
      <span data-price class:list={[compact ? "text-[1.85rem] xl:text-[2.15rem] font-extrabold leading-none" : "text-[2.25rem] sm:text-[2.5rem] xl:text-[2.75rem] font-extrabold leading-none"]}>{formatPrice(initial.price)}</span>
      <span class:list={[compact ? "ml-1 text-[11px] font-bold text-slate-500 uppercase" : "ml-1 text-[13px] sm:text-[14px] font-extrabold tracking-wide text-[#5e7182]"]}>MXN</span>
    </p>
  </div>
  <div class:list={[
    "bg-[#f8faf9] flex flex-col items-center border border-ink-950/[0.06] shrink-0",
    compact ? "rounded-xl px-2 py-1.5 gap-1 shadow-xs" : "bg-white rounded-2xl px-2.5 py-2 shadow-sm gap-1.5 border-ink-950/[0.04]",
  ]}>
    <span class:list={["font-extrabold text-[#1b2a38] leading-none", compact ? "text-[14px]" : "text-[16px]"]}><span data-hours>{initial.hours}</span> h</span>
    <div class="flex gap-1.5">
      <button type="button" data-minus disabled={initialIndex === 0} aria-label={`Reducir horas de ${exam}`} class:list={["rounded-full bg-[#eef1f0] text-[#1b2a38] hover:bg-[#e2e8f0] disabled:opacity-30 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-teal-600 grid place-items-center font-bold", compact ? "size-7 text-sm" : "size-8 bg-[#f1f3f5] text-base"]}>−</button>
      <button type="button" data-plus disabled={initialIndex === packages.length - 1} aria-label={`Aumentar horas de ${exam}`} class:list={["rounded-full bg-[#eef1f0] text-[#1b2a38] hover:bg-[#e2e8f0] disabled:opacity-30 disabled:cursor-not-allowed focus-visible:outline-2 focus-visible:outline-teal-600 grid place-items-center font-bold", compact ? "size-7 text-sm" : "size-8 bg-[#f1f3f5] text-base"]}>+</button>
    </div>
  </div>
  <span data-announcement class="sr-only" role="status" aria-live="polite" aria-atomic="true">{initial.hours} horas por {formatPrice(initial.price)} MXN</span>
</hour-price-picker>

<script>
  import { nextPackageIndex, type HourPackage } from "@/data/hour-packages";

  class HourPricePicker extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = "true";
      const packages: HourPackage[] = JSON.parse(this.dataset.packages!);
      let index = Number(this.dataset.initialIndex);
      const minus = this.querySelector<HTMLButtonElement>("[data-minus]")!;
      const plus = this.querySelector<HTMLButtonElement>("[data-plus]")!;
      const render = (direction: number) => {
        index = nextPackageIndex(index, direction, packages.length);
        const selected = packages[index];
        const price = `$${selected.price.toLocaleString("en-US")}`;
        this.querySelector("[data-hours]")!.textContent = String(selected.hours);
        this.querySelector("[data-price]")!.textContent = price;
        this.querySelector("[data-announcement]")!.textContent = `${selected.hours} horas por ${price} MXN`;
        minus.disabled = index === 0;
        plus.disabled = index === packages.length - 1;
      };
      minus.addEventListener("click", () => render(-1));
      plus.addEventListener("click", () => render(1));
    }
  }
  if (!customElements.get("hour-price-picker")) customElements.define("hour-price-picker", HourPricePicker);
</script>
