---
import { NAV_LINKS } from "@/data/site";
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-500"
>
  <div class="container-edge">
    <nav
      class="mt-4 flex items-center justify-between rounded-2xl px-5 py-3 transition-all duration-500"
      id="nav-shell"
      aria-label="Navegación principal"
    >
      <a href="/" class="group flex items-center gap-2.5" aria-label="Professional Academy, ir al inicio">
        <span class="grid size-9 place-items-center rounded-lg bg-teal-400 font-display text-lg font-bold text-ink-950 transition-transform duration-500 group-hover:rotate-[-8deg]">√</span>
        <span class="font-display text-[15px] leading-tight font-semibold tracking-tight">
          Professional<br /><span class="text-pearl-dim">Academy<sup class="text-teal-400">®</sup></span>
        </span>
      </a>

      <ul class="hidden items-center gap-1 lg:flex">
        {NAV_LINKS.map((link) =>
          "children" in link && link.children ? (
            <li class="group relative">
              <a
                href={link.href}
                class="flex items-center gap-1.5 rounded-full px-4 py-2 font-mono text-[12px] tracking-[0.14em] text-pearl-dim uppercase transition-colors hover:text-pearl"
                aria-haspopup="true"
              >
                {link.label}
                <svg class="size-3 transition-transform duration-300 group-hover:rotate-180" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              </a>
              <div class="invisible absolute left-1/2 top-full -translate-x-1/2 pt-3 opacity-0 transition-all duration-300 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                <ul class="glass min-w-52 rounded-xl p-2 shadow-panel">
                  {link.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="block rounded-lg px-4 py-2.5 text-sm text-pearl-dim transition-colors hover:bg-teal-400/8 hover:text-teal-300"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ) : (
            <li>
              <a
                href={link.href}
                class="rounded-full px-4 py-2 font-mono text-[12px] tracking-[0.14em] text-pearl-dim uppercase transition-colors hover:text-pearl"
              >
                {link.label}
              </a>
            </li>
          )
        )}
      </ul>

      <div class="flex items-center gap-3">
        <a href="/contacto" class="btn-primary hidden !px-5 !py-2.5 !text-[11px] sm:inline-flex" data-magnetic>
          Evaluación gratis
        </a>
        <button
          id="menu-toggle"
          class="grid size-10 place-items-center rounded-full hairline lg:hidden"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M1 4h14M1 8h14M1 12h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </nav>
  </div>

  <div
    id="mobile-menu"
    class="invisible fixed inset-0 z-40 bg-ink-950/95 opacity-0 backdrop-blur-xl transition-all duration-400 lg:hidden"
  >
    <div class="container-edge flex h-full flex-col justify-center gap-2 pt-20">
      {NAV_LINKS.map((link, i) => (
        <div>
          <a
            href={link.href}
            class="block font-display text-4xl font-medium tracking-tight text-pearl transition-colors hover:text-teal-300"
            style={`transition-delay: ${i * 40}ms`}
          >
            {link.label}
          </a>
          {"children" in link && link.children && (
            <div class="mt-2 flex flex-wrap gap-x-5 gap-y-1 pl-1">
              {link.children.map((child) => (
                <a href={child.href} class="font-mono text-xs tracking-widest text-ink-300 uppercase hover:text-teal-300">
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
      <a href="/contacto" class="btn-primary mt-8 self-start">Evaluación gratis</a>
    </div>
  </div>
</header>

<style>
  #site-header.is-scrolled #nav-shell {
    background: rgb(10 16 16 / 0.72);
    backdrop-filter: blur(18px) saturate(1.3);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
    border: 1px solid rgb(247 250 249 / 0.08);
    box-shadow: 0 16px 48px -16px rgb(0 0 0 / 0.6);
  }
  #mobile-menu.is-open {
    visibility: visible;
    opacity: 1;
  }
</style>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", String(!!open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    document.documentElement.classList.toggle("lenis-stopped", !!open);
  });
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      menu.classList.remove("is-open");
      document.documentElement.classList.remove("lenis-stopped");
    })
  );
</script>
