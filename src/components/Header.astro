---
import { NAV_LINKS } from "@/data/site";
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-500"
>
  <div class="container-edge">
    <nav
      class="mt-4 flex items-center justify-between rounded-full px-6 py-3.5 transition-all duration-500"
      id="nav-shell"
      aria-label="Navegación principal"
    >
      <!-- Logo -->
      <a href="/" class="flex items-center" aria-label="Professional Academy, ir al inicio">
        <img src="/Proacademy-logo.webp" alt="Professional Academy" class="h-10 w-auto" width="225" height="56" />
      </a>

      <ul class="hidden items-center gap-2 lg:flex">
        {NAV_LINKS.map((link) =>
          "children" in link && link.children ? (
            <li class="group relative">
              <a
                href={link.href}
                class="flex items-center gap-1.5 rounded-full px-4 py-2 font-display text-[15px] font-semibold text-pearl/80 transition-colors hover:text-teal-300"
                aria-haspopup="true"
              >
                {link.label}
                <svg class="size-3.5 transition-transform duration-300 group-hover:rotate-180" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
              </a>
              <div class="invisible absolute left-1/2 top-full -translate-x-1/2 pt-3 opacity-0 transition-all duration-300 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                <ul class="glass-dark min-w-52 rounded-2xl p-2 shadow-panel">
                  {link.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="block rounded-xl px-4 py-2.5 text-sm font-medium text-pearl/70 transition-colors hover:bg-teal-400/8 hover:text-teal-300"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ) : (
            <li>
              <a
                href={link.href}
                class="rounded-full px-4 py-2 font-display text-[15px] font-semibold text-pearl/80 transition-colors hover:text-teal-300"
              >
                {link.label}
              </a>
            </li>
          )
        )}
      </ul>

      <div class="flex items-center gap-3">
        <button
          id="menu-toggle"
          class="grid size-10 place-items-center rounded-full border border-pearl/15 lg:hidden"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="size-5 text-pearl/70" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </nav>
  </div>

  <div
    id="mobile-menu"
    class="invisible fixed inset-0 z-40 bg-ink-950/97 opacity-0 backdrop-blur-xl transition-all duration-400 lg:hidden"
  >
    <div class="container-edge flex h-full flex-col justify-center gap-2 pt-20">
      {NAV_LINKS.map((link, i) => (
        <div>
          <a
            href={link.href}
            class="block font-display text-4xl font-semibold tracking-tight text-pearl transition-colors hover:text-teal-300"
            style={`transition-delay: ${i * 40}ms`}
          >
            {link.label}
          </a>
          {"children" in link && link.children && (
            <div class="mt-2 flex flex-wrap gap-x-5 gap-y-1 pl-1">
              {link.children.map((child) => (
                <a href={child.href} class="font-display text-base font-medium text-ink-300 hover:text-teal-300">
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
      <a href="/contacto" class="btn-primary mt-8 self-start">Evaluación gratis</a>
    </div>
  </div>
</header>

<style>
  #nav-shell {
    background: rgb(10 16 16 / 0.92);
    border: 1px solid rgb(247 250 249 / 0.09);
    box-shadow: 0 8px 32px -8px rgb(0 0 0 / 0.20), 0 2px 8px -4px rgb(0 0 0 / 0.12);
  }
  #site-header.is-scrolled #nav-shell {
    background: rgb(6 10 10 / 0.96);
    backdrop-filter: blur(24px) saturate(1.4);
    -webkit-backdrop-filter: blur(24px) saturate(1.4);
    border-color: rgb(247 250 249 / 0.12);
    box-shadow: 0 16px 48px -16px rgb(0 0 0 / 0.30);
  }
  #mobile-menu.is-open {
    visibility: visible;
    opacity: 1;
  }
</style>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", String(!!open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    document.documentElement.classList.toggle("lenis-stopped", !!open);
  });
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      menu.classList.remove("is-open");
      document.documentElement.classList.remove("lenis-stopped");
    })
  );
</script>
