---
/**
 * Acordeón de preguntas frecuentes con <details> nativo (accesible por
 * defecto). El schema FAQPage lo emite la página, no este componente.
 */
interface Props {
  faqs: { q: string; a: string }[];
  /** Nombre del grupo para que solo un item esté abierto a la vez. */
  name?: string;
}
const { faqs, name = "faq" } = Astro.props;
---

<div class="hairline-t">
  {faqs.map((faq, i) => (
    <details class="faq-item group hairline-b" name={name} open={i === 0}>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-left transition-colors hover:text-teal-300">
        <span class="font-display text-lg font-medium tracking-tight sm:text-xl">{faq.q}</span>
        <span class="faq-icon grid size-9 shrink-0 place-items-center rounded-full hairline" aria-hidden="true">
          <svg class="size-3.5" viewBox="0 0 14 14" fill="none">
            <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </span>
      </summary>
      <p class="max-w-2xl pb-7 text-[15px] leading-relaxed text-ink-300">
        {faq.a}
      </p>
    </details>
  ))}
</div>
