---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/hanken-grotesk";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";

export interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | Blog Admin</title>
    <style is:global>
      :root {
        color-scheme: light;
        --ink-950: #0b1120;
        --ink-700: #334155;
        --ink-500: #64748b;
        --ink-400: #94a3b8;
        --ink-200: #e2e8f0;
        --ink-100: #eef2f1;
        --ink-50: #f7f9f8;
        --teal-600: #0d9488;
        --teal-700: #0f766e;
        --teal-50: #f0fdfa;
        --pearl: #f4f7f6;
        --red-600: #dc2626;
        --red-50: #fef2f2;
        --font-display: "Bricolage Grotesque Variable", ui-sans-serif, sans-serif;
        --font-body: "Hanken Grotesk Variable", ui-sans-serif, sans-serif;
        --font-mono: "IBM Plex Mono", ui-monospace, monospace;
        --shadow-card: 0 1px 2px rgba(15, 23, 42, 0.04), 0 8px 24px -12px rgba(15, 23, 42, 0.10);
        --shadow-lift: 0 12px 32px -8px rgba(15, 23, 42, 0.16);
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        font-family: var(--font-body);
        background: var(--pearl);
        color: var(--ink-950);
        -webkit-font-smoothing: antialiased;
      }
      h1, h2, h3, .font-display { font-family: var(--font-display); letter-spacing: -0.01em; }
      a { color: inherit; }
      :focus-visible { outline: 2px solid var(--teal-600); outline-offset: 2px; }

      /* -- Header ------------------------------------------------------------ */
      header {
        position: sticky;
        top: 0;
        z-index: 40;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.85rem 1.25rem;
        background: #060a0a;
        color: #fff;
      }
      .brand { display: flex; align-items: center; gap: 0.6rem; text-decoration: none; }
      .brand-mark {
        display: grid;
        place-items: center;
        size: 30px;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: var(--teal-600);
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.85rem;
      }
      .brand-name { font-family: var(--font-display); font-weight: 700; font-size: 0.95rem; letter-spacing: -0.01em; }
      nav.main-nav { display: flex; align-items: center; gap: 1.5rem; font-size: 0.85rem; }
      nav.main-nav a { color: #cbd5e1; font-weight: 500; text-decoration: none; transition: color 0.15s; }
      nav.main-nav a:hover, nav.main-nav a.is-active { color: #5eead4; }
      .nav-cta {
        color: #fff !important;
        background: var(--teal-600);
        padding: 0.45rem 0.9rem;
        border-radius: 8px;
        font-weight: 600;
      }
      .nav-cta:hover { background: var(--teal-700) !important; }
      #menu-toggle { display: none; }
      .logout-btn {
        background: none; border: 0; color: #cbd5e1; font-size: 0.85rem;
        cursor: pointer; padding: 0; font-weight: 500; font-family: var(--font-body);
      }
      .logout-btn:hover { color: #fca5a5; }

      @media (max-width: 780px) {
        nav.main-nav {
          position: fixed;
          inset: 60px 0 0 0;
          flex-direction: column;
          align-items: stretch;
          gap: 0;
          background: #060a0a;
          padding: 0.5rem 1rem 1.5rem;
          transform: translateY(-8px);
          opacity: 0;
          pointer-events: none;
          transition: opacity 0.18s ease, transform 0.18s ease;
        }
        nav.main-nav a, nav.main-nav form { padding: 0.85rem 0.25rem; border-bottom: 1px solid rgba(255,255,255,0.08); }
        nav.main-nav .nav-cta { margin: 0.85rem 0.25rem; text-align: center; }
        #menu-toggle:checked ~ nav.main-nav { opacity: 1; pointer-events: auto; transform: translateY(0); }
        .menu-btn { display: grid !important; }
      }

      .menu-btn {
        display: none;
        place-items: center;
        width: 36px;
        height: 36px;
        border-radius: 8px;
        border: 1px solid rgba(255,255,255,0.15);
        background: transparent;
        color: #fff;
        cursor: pointer;
      }

      main { max-width: 1040px; margin: 0 auto; padding: 2rem 1.25rem 5rem; }
      @media (min-width: 640px) { main { padding: 2.5rem 2rem 6rem; } }

      /* -- Buttons ------------------------------------------------------------ */
      button, .btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        border: 0;
        border-radius: 9px;
        padding: 0.6rem 1.1rem;
        font-size: 0.85rem;
        font-weight: 600;
        font-family: var(--font-body);
        cursor: pointer;
        text-decoration: none;
        transition: background-color 0.15s, transform 0.1s;
        white-space: nowrap;
      }
      button:active, .btn:active { transform: translateY(1px); }
      .btn-primary { background: var(--teal-600); color: #fff; }
      .btn-primary:hover { background: var(--teal-700); }
      .btn-secondary { background: #fff; color: var(--ink-700); border: 1px solid var(--ink-200); }
      .btn-secondary:hover { background: var(--ink-50); }
      .btn-danger { background: var(--red-50); color: var(--red-600); }
      .btn-danger:hover { background: #fee2e2; }
      .btn-ghost { background: transparent; color: var(--ink-500); padding: 0.4rem 0.6rem; }
      .btn-ghost:hover { color: var(--ink-950); }

      /* -- Post list ------------------------------------------------------------ */
      .list-header {
        display: flex; align-items: center; justify-content: space-between;
        gap: 1rem; margin-bottom: 1.75rem; flex-wrap: wrap;
      }
      .list-header h1 { font-size: 1.5rem; margin: 0; }
      .post-cards { display: flex; flex-direction: column; gap: 0.65rem; }
      .post-card {
        display: flex; align-items: center; gap: 1rem;
        background: #fff; border: 1px solid var(--ink-100); border-radius: 12px;
        padding: 1rem 1.15rem; box-shadow: var(--shadow-card);
        transition: box-shadow 0.15s, border-color 0.15s;
      }
      .post-card:hover { border-color: rgba(13,148,136,0.35); box-shadow: var(--shadow-lift); }
      .post-card__main { flex: 1; min-width: 0; }
      .post-card__title { font-weight: 600; font-size: 0.95rem; margin: 0 0 0.15rem; }
      .post-card__meta {
        display: flex; flex-wrap: wrap; gap: 0.5rem 0.9rem;
        font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-500);
      }
      .post-card__slug { color: var(--ink-400); font-family: var(--font-mono); font-size: 0.75rem; }
      .badge {
        display: inline-flex; align-items: center; gap: 0.3rem;
        padding: 0.2rem 0.6rem; border-radius: 999px;
        font-size: 0.68rem; font-weight: 700; font-family: var(--font-mono);
        letter-spacing: 0.03em; text-transform: uppercase;
      }
      .badge::before { content: ""; width: 6px; height: 6px; border-radius: 999px; background: currentColor; }
      .badge-draft { background: #fef3c7; color: #92400e; }
      .badge-published { background: #d1fae5; color: #065f46; }
      .empty-state {
        text-align: center; padding: 4rem 1.5rem; background: #fff;
        border: 1px dashed var(--ink-200); border-radius: 14px; color: var(--ink-500);
      }

      /* -- Forms ------------------------------------------------------------ */
      form.stack { display: flex; flex-direction: column; gap: 1.35rem; max-width: 100%; }
      .field label {
        font-size: 0.78rem; font-weight: 600; color: var(--ink-700);
        display: block; margin-bottom: 0.4rem; font-family: var(--font-mono);
        text-transform: uppercase; letter-spacing: 0.03em;
      }
      input[type="text"], input[type="date"], input[type="password"], textarea, select {
        width: 100%; padding: 0.65rem 0.8rem; border: 1px solid var(--ink-200);
        border-radius: 9px; font-size: 0.92rem; font-family: var(--font-body);
        background: #fff; color: var(--ink-950);
      }
      input:focus, textarea:focus, select:focus {
        outline: 2px solid var(--teal-600); outline-offset: 1px; border-color: var(--teal-600);
      }
      .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
      @media (max-width: 640px) { .field-row { grid-template-columns: 1fr; } }
      .checkbox-row { display: flex; align-items: center; gap: 0.55rem; }
      .checkbox-row input { width: auto; accent-color: var(--teal-600); }
      .checkbox-row label { margin: 0; font-size: 0.85rem; font-weight: 500; text-transform: none; font-family: var(--font-body); }
      .hint { font-size: 0.76rem; color: var(--ink-400); margin-top: 0.35rem; }
      .error-banner {
        background: var(--red-50); color: var(--red-600); padding: 0.75rem 1rem;
        border-radius: 10px; font-size: 0.85rem; font-weight: 500;
      }
      .form-actions {
        display: flex; gap: 0.75rem; padding-top: 0.5rem;
      }

      /* -- Card / panel ------------------------------------------------------------ */
      .panel { background: #fff; border: 1px solid var(--ink-100); border-radius: 14px; padding: 1.5rem; box-shadow: var(--shadow-card); }
      @media (min-width: 640px) { .panel { padding: 2rem; } }

      /* -- Rich text editor ------------------------------------------------------------ */
      .rte-wrap { display: flex; flex-direction: column; }
      .rte-toolbar {
        position: sticky; top: 61px; z-index: 10;
        display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem;
        padding: 0.6rem 0.7rem; background: #fff;
        border: 1px solid var(--ink-200); border-bottom: 0;
        border-radius: 12px 12px 0 0;
        overflow-x: auto;
      }
      .rte-group { display: flex; gap: 0.15rem; padding: 0 0.3rem; border-right: 1px solid var(--ink-100); }
      .rte-group:last-child { border-right: 0; }
      .rte-btn {
        display: grid; place-items: center; min-width: 30px; height: 30px;
        border-radius: 6px; border: 0; background: transparent; color: var(--ink-700);
        font-size: 0.85rem; cursor: pointer; padding: 0 0.35rem;
      }
      .rte-btn:hover { background: var(--ink-50); }
      .rte-btn.is-active { background: var(--teal-50); color: var(--teal-700); }
      .rte-select {
        border: 1px solid var(--ink-200); border-radius: 6px; font-size: 0.78rem;
        padding: 0.3rem 0.4rem; background: #fff; color: var(--ink-700); max-width: 150px;
      }
      .rte-color { position: relative; display: grid; place-items: center; width: 30px; height: 30px; cursor: pointer; border-radius: 6px; }
      .rte-color:hover { background: var(--ink-50); }
      .rte-color input[type="color"] { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
      .rte-canvas {
        border: 1px solid var(--ink-200); border-radius: 0 0 12px 12px;
        background: #fff; padding: 2rem 2.5rem; min-height: 420px;
        box-shadow: var(--shadow-card);
      }
      @media (max-width: 640px) { .rte-canvas { padding: 1.25rem 1.1rem; } }
      .rte-canvas.is-uploading { opacity: 0.7; pointer-events: none; }
      .rte-content { outline: none; min-height: 380px; font-size: 1rem; line-height: 1.75; color: var(--ink-950); }
      .rte-content p.is-editor-empty:first-child::before {
        content: attr(data-placeholder); float: left; color: var(--ink-400); pointer-events: none; height: 0;
      }
      .rte-content h2 { font-family: var(--font-display); font-size: 1.5rem; margin: 1.6em 0 0.5em; font-weight: 700; }
      .rte-content h3 { font-family: var(--font-display); font-size: 1.2rem; margin: 1.4em 0 0.5em; font-weight: 700; }
      .rte-content h4 { font-family: var(--font-display); font-size: 1.05rem; margin: 1.2em 0 0.4em; font-weight: 700; }
      .rte-content p { margin: 0 0 1em; }
      .rte-content ul, .rte-content ol { padding-left: 1.4em; margin: 0 0 1em; }
      .rte-content blockquote { border-left: 3px solid var(--teal-600); margin: 1.2em 0; padding: 0.2em 0 0.2em 1.1em; color: var(--ink-700); font-style: italic; }
      .rte-content img { max-width: 100%; border-radius: 8px; margin: 0.5em 0; }
      .rte-content code { background: var(--ink-50); padding: 0.15em 0.4em; border-radius: 4px; font-family: var(--font-mono); font-size: 0.88em; }
      .rte-content pre { background: var(--ink-950); color: #e2e8f0; padding: 1em; border-radius: 8px; overflow-x: auto; }
      .rte-content pre code { background: none; padding: 0; }
      .rte-content table { border-collapse: collapse; width: 100%; margin: 1em 0; }
      .rte-content th, .rte-content td { border: 1px solid var(--ink-200); padding: 0.5em 0.7em; text-align: left; }
      .rte-content th { background: var(--ink-50); font-weight: 700; }
      .rte-content hr { border: 0; border-top: 1px solid var(--ink-200); margin: 2em 0; }
      .rte-content a { color: var(--teal-700); text-decoration: underline; text-underline-offset: 2px; }
      .rte-footer { font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-400); padding: 0.5rem 0.2rem; }
      .rte-loading { padding: 3rem; text-align: center; color: var(--ink-400); font-size: 0.85rem; }
    </style>
  </head>
  <body>
    <header>
      <a href="/admin" class="brand">
        <span class="brand-mark">PA</span>
        <span class="brand-name">Blog Admin</span>
      </a>
      <input type="checkbox" id="menu-toggle" hidden />
      <label for="menu-toggle" class="menu-btn" aria-label="Abrir menú">☰</label>
      <nav class="main-nav">
        <a href="/admin">Posts</a>
        <a href="/blog" target="_blank">Ver blog ↗</a>
        <a href="/admin/posts/new" class="nav-cta">+ Nuevo post</a>
        <form method="POST" action="/api/admin/logout" style="margin:0">
          <button type="submit" class="logout-btn">Cerrar sesión</button>
        </form>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
