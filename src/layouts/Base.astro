---
import "@/styles/global.css";
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/hanken-grotesk";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import bricolageWoff2 from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";
import hankenWoff2 from "@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url";

import SEO from "@/components/SEO.astro";
import Analytics from "@/components/Analytics.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import WhatsAppFloat from "@/components/WhatsAppFloat.astro";
import StickyCTA from "@/components/StickyCTA.astro";

interface Props {
  title: string;
  description: string;
  schema?: object[];
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  canonicalUrl?: string;
  keywords?: string;
  stickyCta?: boolean;
}

const {
  title, description, schema, ogImage, ogType, noindex,
  canonicalUrl, keywords, stickyCta = true,
} = Astro.props;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-VVYB14H9ZQ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-VVYB14H9ZQ');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" href={bricolageWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={hankenWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon-light.png" type="image/png" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon-dark.png" type="image/png" media="(prefers-color-scheme: dark)" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Blog | Professional Academy" href="/rss.xml" />
    <meta name="theme-color" content="#f7faf9" />
    <SEO {title} {description} {schema} {ogImage} {ogType} {noindex} {canonicalUrl} {keywords} />
    <Analytics />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-teal-400 focus:px-5 focus:py-2.5 focus:font-mono focus:text-xs focus:text-ink-950"
    >
      Saltar al contenido
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <WhatsAppFloat />
    {stickyCta && <StickyCTA />}

    <div class="grain" aria-hidden="true"></div>

    <script>
      import "@/scripts/motion.ts";
    </script>
  </body>
</html>
