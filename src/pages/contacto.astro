---
import Base from "@/layouts/Base.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "@/data/site";
import { breadcrumbSchema, localBusinessSchema } from "@/lib/schema";

const cursos = ["TOEFL iBT", "SAT", "GRE", "GMAT", "PAA"];

const benefits = [
  "Recibe feedback directo y personalizado en clases particulares",
  "Estudia con materiales en línea y simuladores oficiales",
  "Planes flexibles, estudia cuando y donde te convenga",
  "Obtén el puntaje que necesitas en tu examen… ¡garantizado!",
];

const channels = [
  {
    label: "Escríbenos o llámanos",
    icon: "ph:chat-circle",
    rows: [
      {
        icon: "simple-icons:whatsapp",
        text: "(33) 27 98 62 75",
        href: `https://wa.me/${SITE.whatsapp}`,
      },
      {
        icon: "ph:phone",
        text: "(33) 45 23 33 77",
        href: `tel:${SITE.phone.replace(/\s+/g, "")}`,
      },
    ],
  },
  {
    label: "Envíanos un correo",
    icon: "ph:envelope-simple",
    rows: [{ icon: null, text: SITE.email, href: `mailto:${SITE.email}` }],
  },
  {
    label: "Te atenderemos",
    icon: "ph:clock",
    rows: [
      { icon: null, text: "Lun a Vie: 9:00 – 18:00", href: null },
      { icon: null, text: "Sábados: 9:00 – 14:00", href: null },
    ],
  },
];
---

<Base
  title="Contacto | Professional Academy"
  description="Pide informes y agenda tu evaluación diagnóstica gratuita de TOEFL, SAT, GRE, GMAT o PAA. Te atendemos por WhatsApp, teléfono o correo."
  schema={[localBusinessSchema(), breadcrumbSchema([
    { name: "Inicio", url: SITE.url },
    { name: "Contacto", url: `${SITE.url}/contacto` },
  ])]}
  stickyCta={false}
>
  <!-- Banner con imagen de fondo -->
  <section id="contact-hero" class="relative overflow-hidden">
    <div class="absolute inset-0" aria-hidden="true">
      <img
        src="/images/contacto-banner.webp"
        alt=""
        width="1503"
        height="864"
        fetchpriority="high"
        class="size-full object-cover object-[45%_bottom] saturate-[1.25] contrast-[1.10]"
      />
    </div>

    <div class="container-edge relative w-full pt-24 pb-28">
      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
        <div class="hidden lg:block" aria-hidden="true"></div>

        <!-- Contenido a la derecha -->
        <div class="lg:pl-40">
          <h1 class="font-display text-[clamp(2.5rem,4.4vw,4rem)] leading-[1.04] font-semibold tracking-[-0.02em] text-ink-950" data-hero-line>
            <span class="line-mask"><span class="line-inner">Regístrate ahora</span></span>
            <span class="line-mask"><span class="line-inner font-medium text-teal-600">Progresa más rápido</span></span>
          </h1>

          <form id="contact-msg-form" class="mt-6 contact-fade" novalidate>
            <div class="space-y-2.5 font-display text-[clamp(1.05rem,1.5vw,1.35rem)] font-medium leading-relaxed text-ink-950">
              <p>Hola, me llamo <input
                name="nombre" type="text" required autocomplete="name"
                aria-label="Tu nombre completo" placeholder="nombre completo"
                class="cf-field w-[15ch]" /></p>
              <p>Quiero informes del <span class="cf-select-wrap"><select
                name="curso" aria-label="Curso de interés" class="cf-field cf-select w-[16ch]">
                {cursos.map((c) => <option value={c}>curso {c}</option>)}
              </select></span></p>
              <p>Pueden escribirme a <input
                name="correo" type="email" required inputmode="email" autocomplete="email" spellcheck="false"
                aria-label="Tu correo electrónico" placeholder="tu@correo.com"
                class="cf-field w-[15ch]" /></p>
              <p>o llamarme al <input
                name="telefono" type="tel" inputmode="tel" autocomplete="tel"
                aria-label="Tu número de teléfono" placeholder="tu número"
                class="cf-field w-[11ch]" /></p>
            </div>

            <button type="submit" class="btn-primary mt-6 !font-display !text-sm !font-bold !tracking-widest" data-magnetic>
              ENVIAR MENSAJE
            </button>
            <p id="contact-msg-status" class="mt-3 text-sm text-teal-700" role="status" aria-live="polite"></p>
          </form>

          <!-- Beneficios -->
          <ul class="mt-6 max-w-xl divide-y divide-ink-950/10 border-t border-ink-950/10">
            {benefits.map((b) => (
              <li class="flex items-center gap-3.5 py-2.5 contact-fade">
                <span class="grid size-7 shrink-0 place-items-center rounded-full bg-teal-600 text-white" aria-hidden="true">
                  <svg class="size-4" viewBox="0 0 16 16" fill="none">
                    <path d="m3.5 8.5 3 3 6-7" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
                <p class="text-[15px] leading-relaxed text-ink-900">{b}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Canales de contacto directo -->
  <section class="bg-pearl pt-12 pb-24" aria-label="Contacto directo">
    <div class="container-edge">
      <h2 class="text-center font-display text-3xl font-semibold tracking-tight text-ink-950 sm:text-4xl" data-reveal>
        ¿Prefieres contactarnos directamente?
      </h2>

      <ul class="mt-14 grid gap-6 sm:grid-cols-3">
        {channels.map((ch, i) => (
          <li
            class="flex flex-col items-center gap-5 rounded-3xl border border-ink-950/[0.06] bg-ink-50 px-6 py-10 text-center transition-all duration-300 hover:-translate-y-1 hover:border-teal-500/30 hover:bg-white hover:shadow-card-lg"
            data-reveal
            data-reveal-delay={String(i * 0.07)}
          >
            <span class="grid size-14 place-items-center rounded-full bg-teal-600 text-white" aria-hidden="true">
              <Icon name={ch.icon} class="size-6" aria-hidden="true" />
            </span>
            <div>
              <p class="font-mono text-[11px] tracking-[0.2em] text-ink-500 uppercase">{ch.label}</p>
              <div class="mt-2 space-y-1.5 font-display text-lg font-medium text-ink-950">
                {ch.rows.map((row) => {
                  const content = (
                    <>
                      {row.icon && <Icon name={row.icon} class="size-4 shrink-0 text-teal-600" aria-hidden="true" />}
                      <span>{row.text}</span>
                    </>
                  );
                  return row.href ? (
                    <a
                      href={row.href}
                      target={row.href.startsWith("http") ? "_blank" : undefined}
                      rel={row.href.startsWith("http") ? "noopener noreferrer" : undefined}
                      class="flex items-center justify-center gap-2 rounded-md outline-offset-4 transition-colors hover:text-teal-600 focus-visible:text-teal-600"
                    >
                      {content}
                    </a>
                  ) : (
                    <p class="flex items-center justify-center gap-2">{content}</p>
                  );
                })}
              </div>
            </div>
          </li>
        ))}
      </ul>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-2 rounded-2xl border border-ink-950/[0.06] bg-ink-50 px-6 py-5 text-center" data-reveal data-reveal-delay="0.21">
        <Icon name="ph:map-pin" class="size-4 shrink-0 text-teal-600" aria-hidden="true" />
        <span class="font-mono text-[11px] tracking-[0.2em] text-ink-500 uppercase">Dirección (oficina administrativa)</span>
        <span class="font-display text-lg font-medium text-ink-950">
          {SITE.address.street}, {SITE.address.city}
        </span>
      </div>
    </div>
  </section>
</Base>

<style>
  .cf-field {
    display: inline-block;
    background: transparent;
    border: 0;
    border-bottom: 2px dashed rgb(13 148 136 / 0.55);
    color: var(--color-teal-700);
    padding: 0 0.3em 0.1em;
    outline: none;
    text-align: center;
    transition: border-color 0.25s, background-color 0.25s;
    font: inherit;
  }
  .cf-field::placeholder {
    color: rgb(13 148 136 / 0.6);
  }
  .cf-field:focus {
    border-bottom-color: var(--color-teal-600);
    background: rgb(20 184 166 / 0.07);
  }
  .cf-select-wrap {
    position: relative;
    display: inline-block;
  }
  .cf-select {
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
    padding-right: 1.4em;
    text-align: left;
    width: auto;
  }
  .cf-select-wrap::after {
    content: "";
    position: absolute;
    right: 0.4em;
    top: 50%;
    transform: translateY(-25%);
    border-left: 0.3em solid transparent;
    border-right: 0.3em solid transparent;
    border-top: 0.42em solid var(--color-teal-600);
    pointer-events: none;
  }
  .cf-select option {
    background: #fff;
    color: var(--color-ink-950);
  }
  .cf-field[aria-invalid="true"] {
    border-bottom-color: #ef4444;
  }
</style>

<script define:vars={{ whatsapp: SITE.whatsapp }}>
  function initContactMsg() {
    const form = document.getElementById("contact-msg-form");
    if (!form || form.dataset.bound) return;
    form.dataset.bound = "true";
    const status = document.getElementById("contact-msg-status");

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const nombre = String(data.get("nombre") || "").trim();
      const curso = String(data.get("curso") || "");
      const correo = String(data.get("correo") || "").trim();
      const telefono = String(data.get("telefono") || "").trim();

      const setError = (name, msg) => {
        const el = form.querySelector(`[name="${name}"]`);
        el?.setAttribute("aria-invalid", "true");
        el?.focus();
        if (status) status.textContent = msg;
      };

      if (nombre.length < 2) return setError("nombre", "Escribe tu nombre para continuar.");
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(correo))
        return setError("correo", "Escribe un correo válido, por ejemplo nombre@correo.com.");

      form.querySelectorAll("[aria-invalid]").forEach((el) => el.removeAttribute("aria-invalid"));
      if (status) status.textContent = "Enviando mensaje…";

      fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ nombre, correo, telefono, curso, fromUrl: window.location.href }),
      }).finally(() => {
        if (status) {
          status.innerHTML = `¡Mensaje enviado perfectamente! <br/><span class="text-xs opacity-80 mt-1 block">Abriendo WhatsApp en 5 segundos...</span>`;
          status.classList.add("text-teal-600");
          status.classList.remove("text-teal-300");
        }

        const msg = [
          `Hola, me llamo ${nombre}.`,
          `Quiero informes del curso ${curso}.`,
          correo ? `Mi correo: ${correo}` : null,
          telefono ? `Mi teléfono: ${telefono}` : null,
        ].filter(Boolean).join("\n");

        window.dataLayer?.push({ event: "generate_lead", lead_exam: curso });
        
        setTimeout(() => {
          if (status) status.innerHTML = "¡Mensaje enviado perfectamente!";
          window.open(`https://wa.me/${whatsapp}?text=${encodeURIComponent(msg)}`, "_blank", "noopener,noreferrer");
        }, 5000);
      });
    });
  }

  initContactMsg();
  document.addEventListener("astro:page-load", initContactMsg);
</script>

<style>
  .contact-fade {
    opacity: 0;
  }
  html.no-motion .contact-fade {
    opacity: 1;
  }
  [data-hero-line] .line-inner {
    display: block;
    transform: translateY(110%);
  }
  [data-hero-line] .line-mask {
    display: block;
    overflow: hidden;
  }
</style>

<script>
  import gsap from "gsap";

  function initContactHero() {
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const tl = gsap.timeline({ defaults: { ease: "expo.out" } });
      tl.to("#contact-hero [data-hero-line] .line-inner", {
        y: 0,
        duration: 1.2,
        stagger: 0.1,
        delay: 0.1,
      }).fromTo(
        "#contact-hero .contact-fade",
        { opacity: 0, y: 20 },
        { opacity: 1, y: 0, duration: 1, stagger: 0.08 },
        "-=0.8"
      );
    } else {
      document.querySelectorAll(".contact-fade").forEach((el) => {
        (el as HTMLElement).style.opacity = "1";
      });
      document.querySelectorAll("[data-hero-line] .line-inner").forEach((el) => {
        (el as HTMLElement).style.transform = "none";
      });
    }
  }

  initContactHero();
  document.addEventListener("astro:page-load", initContactHero);
</script>
