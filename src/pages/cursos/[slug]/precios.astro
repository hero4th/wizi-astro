---
import { Icon } from "astro-icon/components";
import Base from "@/layouts/Base.astro";
import FAQList from "@/components/FAQList.astro";
import HourPricePicker from "@/components/HourPricePicker.astro";
import { PAA_HOUR_PACKAGES, PAA_ESSENTIAL_PRICE_MXN } from "@/data/hour-packages";
import { PROGRAMS } from "@/data/programs";
import { SITE } from "@/data/site";
import { breadcrumbSchema, faqSchema } from "@/lib/schema";

export function getStaticPaths() {
  return PROGRAMS.map((program) => ({
    params: { slug: program.slug },
    props: { program },
  }));
}

const { program } = Astro.props;
const EXAM = program.exam;

const heroBadges = [
  "Recibe retroalimentación en clases particulares",
  "Estudia con materiales y simuladores actualizados",
  "Planes flexibles, cuando y donde quieras",
];

type Feature = string | { label: string; note?: string; isHighlight?: boolean };

interface Tier {
  name: string;
  description: string;
  priceNote: string;
  price: string;
  priceUnit: string;
  includesTitle: string;
  features: Feature[];
  guarantee: string;
  dark?: boolean;
  lightGreen?: boolean;
  recommended?: boolean;
  tag?: [string, string];
  students?: string;
  isInteractive?: boolean;
  hidden?: boolean;
}

const tiers: Tier[] = [
  {
    name: "Pro Essentials",
    description: "Para estudiantes disciplinados que buscan material de alta calidad.",
    priceNote: "Pago único, acceso por 6 meses",
    price: "$2,200",
    priceUnit: "MXN",
    includesTitle: "¿Qué incluye este plan?",
    features: [
      "Acceso a la plataforma digital",
      "+10 exámenes de simulación",
      "Tutor de IA Integrado",
      "+2,000 preguntas de práctica",
      "Lecciones en video",
    ],
    guarantee: "Si logras menos del 80% de tu puntaje objetivo, te devolvemos tu dinero.",
  },
  {
    name: "Pro Advanced",
    recommended: true,
    description: "Evalúa tu nivel y trabaja en tus debilidades con la ayuda de nuestros expertos.",
    priceNote: "A partir de 5 horas por:",
    price: "$3,490",
    priceUnit: "MXN",
    includesTitle: "Incluye todo del plan Essentials, más:",
    features: [
      "Diagnóstico de tu nivel",
      "Plan de estudio personalizado",
      { label: "Clases 1:1 en vivo", note: "Contrata horas extra si lo necesitas" },
      "20 exámenes de simulación",
      "Horarios flexibles adaptables",
    ],
    guarantee: "Si logras menos del 85% de tu puntaje objetivo, te devolvemos tu dinero.",
  },
  {
    name: "Pro Plus",
    dark: true,
    description: "Programa intensivo con acompañamiento constante para resultados garantizados.",
    priceNote: "A partir de:",
    price: "$14,990",
    priceUnit: "/MXN",
    tag: ["Paga de contado", "Ahorra 15%"],
    includesTitle: "Incluye todo del plan Advanced, más:",
    features: [
      "20 horas de clase en vivo 1:1",
      "Maestros certificados",
      "Retroalimentación detallada",
      "Kit de estrategia para el día del examen",
    ],
    guarantee: "Si logras menos del 90% de tu puntaje objetivo, te rembolsamos el 100% de tu dinero.",
    students: "+1,500",
  },
];

const paaTiers: Tier[] = [
  {
    name: "Pro Esencial",
    description: "Para estudiantes disciplinados que<br/>buscan material de alta calidad.",
    priceNote: "Pago único, acceso por 6 meses",
    price: `$${PAA_ESSENTIAL_PRICE_MXN.toLocaleString("en-US")}`,
    priceUnit: "MXN",
    includesTitle: "¿QUÉ INCLUYE ESTE PLAN?",
    features: [
      "Acceso a la plataforma digital",
      "+20 exámenes de simulación",
      "Tutor de IA Integrado",
      "+5,000 preguntas de práctica",
      "Lecciones en video",
    ],
    guarantee: "Si no logras el 80% en tu examen oficial, te devolvemos el 100% del dinero.",
  },
  {
    name: "Pro Avanzado",
    recommended: true,
    isInteractive: true,
    description: "Evalúa tu nivel y trabaja en tus debilidades<br/>con la ayuda de nuestros expertos.",
    priceNote: "Elige tus clases en vivo:",
    price: "$8,900",
    priceUnit: "MXN",
    includesTitle: "INCLUYE TODO DEL PLAN ESENCIAL, MÁS:",
    features: [
      "Diagnóstico de tu nivel",
      "Plan de estudio personalizado",
      { label: "Clases 1:1 en vivo", note: "10 a 20 h (ajustable según diagnóstico)" },
      "Horarios flexibles adaptables",
    ],
    guarantee: "Si no logras el 85% en tu examen oficial, te devolvemos el 100% del dinero.",
  },
  {
    name: "Pro Élite",
    lightGreen: true,
    description: "Programa intensivo con acompañamiento<br/>constante para resultados garantizados.",
    priceNote: "A partir de:",
    price: "$29,000",
    priceUnit: "/MXN",
    tag: ["PAGO DE CONTADO", "AHORRA 15%"],
    includesTitle: "INCLUYE TODO DEL PLAN AVANZADO, MÁS:",
    features: [
      "40 horas de clase en vivo 1:1",
      "Maestros certificados",
      "Retroalimentación detallada",
      "Kit de estrategia para el día del examen",
    ],
    guarantee: "Si no logras el 85% en tu examen oficial, te devolvemos el 100% del dinero.",
    students: "+1,500",
  },
  {
    name: "Pro Élite - Grupal",
    dark: true,
    hidden: true,
    description: "Programa intensivo con otros aspirantes para una mejor experiencia... garantizado.",
    priceNote: "A partir de:",
    price: "$7,900",
    priceUnit: "/MXN",
    includesTitle: "INCLUYE TODO DEL PLAN AVANZADO, MÁS:",
    features: [
      "40 horas de clase grupal",
      "Maestros certificados",
      "Retroalimentación detallada",
      "Kit de estrategia para el día del examen",
      { label: "Consulta horarios matutinos y vespertinos", isHighlight: true }
    ],
    guarantee: "Si no logras el 80% en tu examen oficial, te devolvemos el 100% del dinero.",
    students: "+1,500",
  }
];

// Herón confirmed SAT uses PAA tariffs and the existing four hour packages.
// Clone SAT content so its guarantee and wording never mutate PAA.
const isSat = program.slug === "sat";
const satTiers: Tier[] = paaTiers.map((tier) => ({
  ...tier,
  guarantee: program.guarantee,
  features: tier.features.map((feature) =>
    typeof feature !== "string" && feature.label === "Clases 1:1 en vivo"
      ? { ...feature, note: "Elige 5, 10, 20 o 30 horas" }
      : feature,
  ),
}));
const currentTiers = isSat ? satTiers : program.slug === "paa" ? paaTiers : tiers;

const waLink = (plan: string) =>
  `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(
    `Hola, me interesa el plan ${plan} del curso ${EXAM}. ¿Me pueden dar más información?`,
  )}`;

const faqs = [
  {
    q: `¿Qué incluye el curso ${EXAM} de Professional Academy?`,
    a: "Dependiendo del plan, tendrás acceso completo a la plataforma con simuladores idénticos al examen real, material oficial, +2,000 ejercicios para practicar, retroalimentación personalizada 1 a 1 y más de 20 horas de lecciones en video.",
  },
  {
    q: "¿Qué nivel necesito para tomar estos cursos?",
    a: "En tu diagnóstico inicial medimos tu punto de partida y ajustamos el plan para llevarte al puntaje objetivo, sin importar dónde empieces.",
  },
  {
    q: "¿Por cuánto tiempo tengo acceso a la plataforma digital?",
    a: "El plan Essentials incluye 6 meses de acceso. En los planes Advanced y Plus el acceso se mantiene durante todo tu programa de preparación, hasta la fecha de tu examen.",
  },
  {
    q: "¿Cómo funciona la garantía de puntaje?",
    a: "Si al terminar tu curso y presentar el examen no alcanzas el porcentaje de tu puntaje objetivo indicado en tu plan, te reembolsamos tu inversión según lo estipulado. Aplican nuestros Términos y Condiciones.",
  },
];

if (isSat) {
  faqs[0].a = "Dependiendo del plan, tendrás acceso a la plataforma digital, más de 5,000 preguntas de práctica, 20 exámenes de simulación y clases en vivo. Consulta los servicios incluidos en cada tarjeta.";
  faqs[2].a = "El plan Pro Esencial incluye 6 meses de acceso. En Pro Avanzado y Pro Élite, el acceso se mantiene durante tu programa de preparación, hasta la fecha de tu examen.";
  faqs[3].a = `${program.guarantee} Aplican nuestros Términos y Condiciones.`;
}

const schema = [
  faqSchema(faqs),
  breadcrumbSchema([
    { name: "Inicio", url: SITE.url },
    { name: "Cursos", url: `${SITE.url}/cursos` },
    { name: EXAM, url: `${SITE.url}/cursos/${program.slug}` },
    { name: "Precios", url: `${SITE.url}/cursos/${program.slug}/precios` },
  ]),
];
---

<Base
  title={`Precios del curso ${EXAM} | Professional Academy`}
  description={`Elige tu modalidad de estudio para el ${EXAM}: ${isSat ? "Pro Esencial, Pro Avanzado o Pro Élite" : "Pro Essentials, Pro Advanced o Pro Plus"}. Simuladores oficiales, clases 1 a 1 y Garantía de Puntaje.`}
  schema={schema}
  stickyCta={false}
>
  <!-- HERO (oscuro) -->
  <section class="relative overflow-hidden" style="background-color: rgb(6 10 10)">
    <div class="pointer-events-none absolute -right-24 top-0 h-[42rem] w-[42rem] rounded-full bg-teal-600/12 blur-[140px]" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -left-40 bottom-[-22rem] h-[42rem] w-[42rem] rounded-full bg-teal-900/40 blur-[120px]" aria-hidden="true"></div>

    <div class="container-edge relative pt-40 pb-24">
      <div class="pp-hero">
        <div>
          <h1 class="font-display text-[clamp(2.75rem,5.6vw,4.6rem)] leading-[1.02] font-semibold tracking-[-0.03em] text-pearl" data-reveal-line>
            <span class="line-mask"><span class="line-inner">La mejor opción</span></span>
            <span class="line-mask"><span class="line-inner"><em class="font-display italic font-medium text-teal-400 pr-2">para aprobar.</em></span></span>
          </h1>
          <p class="mt-7 max-w-lg text-[17px] leading-relaxed text-ink-300" data-reveal>
            Selecciona tu modalidad de estudio para {EXAM} y asegura el mejor puntaje. Preparación enfocada, estratégica y garantizada.
          </p>
        </div>

        <div class="pp-badges" data-reveal>
          {heroBadges.map((text, i) => (
            <div class:list={["inline-flex items-center gap-3.5 rounded-2xl bg-white px-5 py-3.5 shadow-[0_20px_46px_-18px_rgba(0,0,0,0.75)]", `pp-badge-${i}`]}>
              <span class="grid size-6 shrink-0 place-items-center rounded-full bg-teal-600" aria-hidden="true">
                <Icon name="ph:check" class="size-3.5 text-white" />
              </span>
              <span class="text-[14px] font-medium text-ink-800">{text}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- PRECIOS (claro) -->
  <section class="bg-pearl py-20" aria-label={`Planes del curso ${EXAM}`}>
    <div class="container-edge !max-w-[88rem]">
      <div class="flex items-center justify-center gap-2.5 sm:gap-3 text-center" data-reveal>
        <Icon name="ph:seal-percent-fill" class="size-6 sm:size-7 shrink-0 text-[#00bda0]" aria-hidden="true" />
        <p class="text-lg sm:text-xl">
          <span class="font-extrabold tracking-tight text-[#00a88f]">Disponible por tiempo limitado</span>
          <span class="font-medium text-ink-600"> — Solo quedan 5 cupos este mes</span>
        </p>
      </div>

      <div class="pp-cards mt-12">
        {currentTiers.map((t, idx) => (
          <div
            class:list={[
              "pp-card relative flex flex-col rounded-3xl p-6 sm:p-8 xl:p-9",
              `pp-card-${idx}`,
              t.hidden && "hidden",
              t.dark 
                ? "pp-card-dark text-pearl shadow-2xl shadow-black/30" 
                : t.lightGreen
                  ? "bg-[#c6e9e0] text-ink-950 shadow-lg"
                  : "bg-[#f1f3f5] text-ink-950",
              !t.dark && !t.lightGreen && idx === 1 && "lg:border-l lg:border-ink-950/[0.06]",
              idx === 2 && "lg:!pt-[3.5rem] xl:!pt-[3.75rem]",
            ]}
            style={t.dark ? "background-image: linear-gradient(158deg, #112b26 0%, #0d211d 52%, #081714 100%)" : undefined}
            data-reveal
            data-reveal-delay={String(idx * 0.06)}
          >
            {t.recommended && (
              <span class="absolute right-7 top-0 -translate-y-1/2 whitespace-nowrap rounded-full bg-[#008f7a] px-3.5 py-1 font-mono text-[10px] font-bold tracking-[0.16em] text-white shadow-md uppercase">
                Recomendado
              </span>
            )}

            <div class="min-h-[6.5rem] sm:min-h-[7rem] lg:min-h-[7.5rem] flex flex-col justify-start">
              <h2 class:list={["font-display text-[2rem] sm:text-[2.25rem] font-extrabold tracking-tight leading-none", t.dark ? "text-pearl" : "text-[#1b2a38]"]}>{t.name}</h2>
              <p class:list={["mt-3 max-w-[29ch] text-[15px] font-medium leading-relaxed", t.dark ? "text-ink-300" : "text-[#475569]"]} set:html={t.description}></p>
            </div>

            <!-- Precio -->
            <div class:list={["mt-5 min-h-[5.5rem] lg:min-h-[5.75rem] flex flex-row justify-between", t.isInteractive ? "items-end" : "items-start"]}>
              {t.isInteractive ? (
                <HourPricePicker packages={PAA_HOUR_PACKAGES} exam={EXAM} note={t.priceNote} />
              ) : (
              <div class="flex flex-col justify-start w-full">
                <p class:list={["text-[14px] font-medium", t.dark ? "text-ink-300" : "text-[#475569]"]}>{t.priceNote}</p>
                <div class="mt-1 flex items-end justify-between gap-2 sm:gap-3 xl:gap-4 w-full">
                  <p class:list={["font-display tracking-tight whitespace-nowrap shrink-0 flex items-baseline", t.dark ? "text-pearl" : "text-[#1b2a38]"]}>
                    <span id={t.isInteractive ? "interactive-price" : undefined} class="text-[2.6rem] sm:text-[2.85rem] xl:text-[3.1rem] font-extrabold leading-none">{t.price}</span>
                    <span class:list={["ml-1.5 text-[14px] sm:text-[15px] font-extrabold tracking-wide uppercase", t.dark ? "text-ink-300" : "text-[#5e7182]"]}>{t.priceUnit}</span>
                  </p>
                  {t.tag && (
                    <span
                      class="inline-flex flex-col justify-center items-center text-center pl-[22px] sm:pl-[26px] xl:pl-[28px] pr-[12px] sm:pr-[14px] xl:pr-[16px] py-[8px] sm:py-[10px] xl:py-[10px] shrink-0 translate-y-[-4px]"
                      style={t.lightGreen ? "background-color: #00cfab; border-radius: 12px; clip-path: polygon(15px 0%, 100% 0%, 100% 100%, 15px 100%, 0% 50%);" : "background-color: #354245; border-radius: 12px; clip-path: polygon(15px 0%, 100% 0%, 100% 100%, 15px 100%, 0% 50%);"}
                    >
                      <span class:list={["font-display text-[10px] sm:text-[10.5px] xl:text-[11px] font-extrabold tracking-[0.04em] uppercase leading-none", t.lightGreen ? "text-[#061713]" : "text-white"]}>{t.tag[0]}</span>
                      <span class:list={["font-display text-[14px] sm:text-[15px] xl:text-[16px] font-black tracking-normal uppercase leading-none mt-1", t.lightGreen ? "text-[#061713]" : "text-white"]}>{t.tag[1]}</span>
                    </span>
                  )}
                </div>
              </div>
              )}
            </div>

            <a
              href={waLink(t.name)}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-6 inline-flex self-start items-center justify-center rounded-full bg-[#00cfab] px-8 sm:px-10 py-3.5 font-display text-[13px] font-bold tracking-widest text-ink-950 shadow-sm transition-colors hover:bg-[#00bda0] uppercase"
              data-magnetic
              data-event={`pricing_contact_${t.name.toLowerCase().replace(/\s+/g, "_")}`}
            >
              CONTÁCTANOS
            </a>

            <!-- Incluye -->
            <p class:list={["mt-8 min-h-[2rem] font-mono text-[11px] font-extrabold tracking-[0.16em] uppercase flex items-center", t.dark ? "text-[#00cfab]" : "text-[#008f7a]"]}>{t.includesTitle}</p>
            <div class:list={["mt-3.5 h-px w-full", t.dark ? "bg-white/10" : "bg-ink-950/[0.08]"]} aria-hidden="true"></div>
            <ul class="mt-4 space-y-3.5 mb-10 sm:mb-12 xl:mb-14">
              {t.features.map((f) => {
                const label = typeof f === "string" ? f : f.label;
                const note = typeof f === "string" ? undefined : f.note;
                const isHighlight = typeof f === "string" ? false : f.isHighlight;
                return (
                  <li class="flex items-start gap-3">
                    {t.dark ? (
                      <span class="mt-px grid size-5 shrink-0 place-items-center rounded-full bg-[#1c3e37] text-white" aria-hidden="true">
                        <Icon name="ph:check" class="size-3" />
                      </span>
                    ) : (
                      <Icon name="ph:check-circle" class="mt-px size-5 shrink-0 text-[#009485]" aria-hidden="true" />
                    )}
                    <span class="min-w-0">
                      <span class:list={["block text-[15px] font-medium leading-snug", t.dark ? "text-ink-100" : "text-[#475569]", isHighlight && "!text-[#00cfab] font-bold"]}>{label}</span>
                      {note && <span class="mt-0.5 block text-[13px] font-medium leading-snug text-[#5e7182]">{note}</span>}
                    </span>
                  </li>
                );
              })}
            </ul>

            <!-- Garantía -->
            <div class:list={[
              "mt-auto rounded-3xl p-6 sm:p-7 shadow-sm",
              t.dark ? "bg-[#13332e] border border-white/10" : t.lightGreen ? "bg-white/40 border border-white/50" : "bg-[#e2f8f3]",
            ]}>
              <div class="flex items-center gap-3">
                <Icon name="ph:seal-check" class:list={["size-7 shrink-0", t.dark ? "text-white" : "text-[#008f7a]"]} aria-hidden="true" />
                <p class:list={["font-display text-[19px] sm:text-[21px] font-bold tracking-tight leading-none", t.dark ? "text-white" : "text-[#007f6d]"]}>Garantía de puntaje</p>
              </div>
              <p class:list={["mt-3 text-[13.5px] sm:text-[14px] leading-relaxed", t.dark ? "text-ink-300" : "text-ink-600"]}>{t.guarantee}</p>
              <p class:list={["mt-2 text-[11px] sm:text-[12px]", t.dark ? "text-ink-400" : "text-ink-400"]}>
                *Sujeto a nuestros <span class:list={["font-semibold", t.dark ? "text-ink-200" : "text-ink-700"]}>Términos y Condiciones</span>
              </p>
              {t.students && (
                <div class="mt-4 flex flex-wrap items-center gap-2 sm:gap-2.5 border-t border-white/10 pt-3.5">
                  <span class="font-mono text-[10px] sm:text-[10.5px] font-bold tracking-[0.14em] text-ink-300 uppercase">Han tomado este curso</span>
                  <span class="font-display text-lg sm:text-xl font-extrabold text-[#00cfab]">{t.students}</span>
                  <span class="text-[12px] sm:text-[13px] text-ink-200">Estudiantes</span>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- RESOLVEMOS TUS DUDAS (oscuro) -->
  <section class="relative overflow-hidden py-24" style="background-color: rgb(6 10 10)" aria-label="Preguntas frecuentes">
    <div class="pointer-events-none absolute -left-64 bottom-[-28rem] h-[56rem] w-[56rem] rounded-full bg-teal-900/25 blur-[8px]" aria-hidden="true"></div>

    <div class="container-edge relative">
      <div class="pp-faq">
        <div class="pp-faq-aside" data-reveal>
          <h2 class="font-display text-4xl font-semibold leading-[1.05] tracking-tight text-pearl sm:text-5xl">
            Resolvemos<br />
            <span class="text-teal-400">tus dudas.</span>
          </h2>
          <p class="mt-5 max-w-sm text-[15px] leading-relaxed text-ink-300">
            Las respuestas que más nos piden antes de inscribirse. Si tu pregunta no está aquí, ponte en contacto con nosotros.
          </p>
          <a href="/preguntas-frecuentes" class="btn-primary mt-8 !font-display !text-sm !font-bold !tracking-widest" data-magnetic>
            CONOCER MÁS
          </a>
        </div>

        <div data-reveal>
          <FAQList faqs={faqs} name={`faq-precios-${program.slug}`} variant="dark" />
        </div>
      </div>
    </div>
  </section>
</Base>



<style>
  /* ---- HERO ---- */
  .pp-hero {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .pp-hero {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  .pp-badges {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  @media (min-width: 1024px) {
    .pp-badges {
      margin-left: auto;
      width: fit-content;
      align-items: flex-start;
    }
    .pp-badge-0 { margin-left: 0; width: calc(100% - 2.5rem); }
    .pp-badge-1 { margin-left: 2.5rem; }
    .pp-badge-2 { margin-left: 0; width: calc(100% - 2.5rem); }
  }

  /* ---- PRICING CARDS ---- */
  .pp-cards {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 1024px) {
    .pp-cards {
      grid-template-columns: 1fr 1fr 1.16fr;
      gap: 0;
      align-items: stretch;
    }
    .pp-card-0 {
      border-top-right-radius: 0;
      border-bottom-right-radius: 0;
      border-right: 0;
    }
    .pp-card-1 {
      border-top-left-radius: 0;
      border-bottom-left-radius: 0;
    }
    .pp-card-2 {
      margin: -1.5rem 0 -1.5rem 1.25rem;
      z-index: 10;
    }
  }

  /* ---- FAQ ---- */
  .pp-faq {
    display: grid;
    gap: 3rem;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .pp-faq {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 5rem;
    }
    .pp-faq-aside {
      position: sticky;
      top: 7rem;
    }
  }
</style>
