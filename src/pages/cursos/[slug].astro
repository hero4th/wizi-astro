---
import { Icon } from "astro-icon/components";
import Base from "@/layouts/Base.astro";
import FAQList from "@/components/FAQList.astro";
import HourPricePicker from "@/components/HourPricePicker.astro";
import { PAA_HOUR_PACKAGES, PAA_ESSENTIAL_PRICE_MXN } from "@/data/hour-packages";
import { PROGRAMS } from "@/data/programs";
import { SITE } from "@/data/site";
import { TESTIMONIALS } from "@/data/testimonials";
import { breadcrumbSchema, courseSchema, faqSchema } from "@/lib/schema";

export function getStaticPaths() {
  return PROGRAMS.map((program) => ({
    params: { slug: program.slug },
    props: { program },
  }));
}

const { program } = Astro.props;
const isSat = program.slug === "sat";
const isPaa = program.slug === "paa";
const isDecoupled = isSat || isPaa;

const priceFormatted = new Intl.NumberFormat("es-MX", {
  style: "currency",
  currency: "MXN",
  maximumFractionDigits: 0,
}).format(program.priceMXN);

const stats = isPaa
  ? [
      { text: "Clase 1 a 1", label: "Lecciones personalizadas" },
      { value: 5000, prefix: "+", label: "Ejercicios prácticos" },
      { value: 20, label: "Evaluaciones completas" },
      { value: 150, prefix: "+", label: "Puntos garantizados" },
    ]
  : [
      { value: program.sessions, label: "sesiones de clase" },
      { value: program.exercises, label: "ejercicios prácticos", prefix: "+" },
      { value: program.evaluations, label: "evaluaciones completas" },
      { value: program.hours, label: "horas grabadas en HD", prefix: "+" },
    ];

const featureIcons = ["ph:book-open", "ph:clipboard-text", "ph:graduation-cap", "ph:seal-check"];
const examIcons = isSat
  ? ["ph:book-open", "ph:math-operations"]
  : program.slug === "paa"
    ? ["ph:book-open", "ph:pencil-simple", "ph:calculator", "ph:globe-hemisphere-west"]
    : ["ph:book-open", "ph:headphones", "ph:pencil-simple", "ph:microphone"];
const academicIntro = program.academicIntro ?? program.audience;
const examShort = program.exam.split(" ")[0];

const comparison = program.comparison ?? [
  { label: "Precio total", pa: priceFormatted, trad: "+$30,000" },
  { label: "Duración del curso", pa: `${program.hours} horas`, trad: "8 semanas" },
  { label: "Preguntas de práctica", pa: `más de ${program.exercises.toLocaleString("es-MX")}`, trad: "Libro limitado" },
  { label: "Calificación de ensayos", pa: "Evaluación profesional", trad: "Inteligencia artificial" },
  { label: "Garantía de puntuación", pa: "+15 puntos", trad: "Varía" },
  { label: `Simuladores ${examShort}`, pa: "Incluidos", trad: "Varía" },
];

const benefits = program.benefits ?? [
  "Recibe retroalimentación en clases particulares",
  "Estudia con materiales y simuladores actualizados",
  "Planes flexibles, cuando y donde quieras",
  "Obtén el puntaje que necesitas… ¡garantizado!",
];

// Beneficios laterales en sección de precios PAA (Figma)
const paaPriceBenefits = [
  "Recibe retroalimentación en clases 1 a 1",
  "Estudia con materiales y simuladores actuales",
  "Planes flexibles, cuando y donde quieras",
  "Obtén el puntaje que necesitas... ¡garantizado!",
];

const paaTestimonials = TESTIMONIALS.filter((t) => t.program.toUpperCase() === "PAA");

const schema = [
  courseSchema(program),
  faqSchema(program.faqs),
  breadcrumbSchema([
    { name: "Inicio", url: SITE.url },
    { name: "Cursos", url: `${SITE.url}/cursos` },
    { name: program.exam, url: `${SITE.url}/cursos/${program.slug}` },
  ]),
];
---

<Base title={program.metaTitle} description={program.metaDescription} schema={schema} stickyCta={false}>
  <div data-course={program.slug}>
  <!-- HERO (oscuro) -->
  <section class="course-hero relative overflow-hidden hairline-b-dim" style="background-color: rgb(6 10 10)">
    <div class="pointer-events-none absolute -right-32 top-0 h-[34rem] w-[34rem] rounded-full bg-teal-600/12 blur-[130px]" aria-hidden="true"></div>

    <div class:list={["container-edge relative pb-16", isPaa ? "pt-36 lg:pt-40 lg:min-h-[45rem] lg:pb-14" : "pt-36 lg:min-h-[42rem] lg:pb-0"]}>
      <div class:list={["relative z-10", isPaa ? "max-w-2xl lg:max-w-[55%] xl:max-w-[58%] lg:pt-4" : "max-w-xl lg:max-w-[49%] lg:pt-12"]}>
        <nav aria-label="Ruta de navegación" class="font-mono text-[11px] tracking-[0.18em] text-ink-400 uppercase">
          <a href="/" class="transition-colors hover:text-teal-300">Inicio</a>
          <span aria-hidden="true"> / </span>
          <a href="/cursos" class="transition-colors hover:text-teal-300">Cursos</a>
          <span aria-hidden="true"> / </span>
          <span class="text-teal-400">{program.exam}</span>
        </nav>

        {isPaa ? (
          <div class="mt-5">
            <h1 class="font-display text-[clamp(2.5rem,5.2vw,4.25rem)] leading-[1.08] font-semibold tracking-[-0.03em] text-pearl">
              Curso PAA<br />
              College Board<br />
              <span class="text-[#00cfab]">¡garantizado!</span>
            </h1>
            <p class="mt-6 max-w-lg text-[17px] leading-relaxed text-ink-300">
              Clases en vivo 1 a 1, simuladores reales y profesores expertos para asegurar tu lugar en la UDG, El Tec de Monterrey y la UDEM.
            </p>
          </div>
        ) : (
          <div>
            <h1 class="mt-6 font-display text-[clamp(2.75rem,5.6vw,4.5rem)] leading-[1.02] font-semibold tracking-[-0.03em] text-pearl" data-reveal-line>
              <span class="line-mask"><span class="line-inner">Curso {program.exam}</span></span>
              <span class="line-mask"><span class="line-inner"><em class="font-display italic font-medium text-teal-400">¡garantizado!</em></span></span>
            </h1>
            <p class="mt-6 max-w-lg text-lg leading-relaxed text-ink-300" data-reveal>
              {program.subheadline}
            </p>
          </div>
        )}

        <div class="mt-9 flex flex-wrap items-center gap-4" data-reveal>
          <a href={isPaa ? "#precios" : "/contacto"} class="inline-flex items-center justify-center rounded-full bg-[#00cfab] px-8 py-3.5 font-display text-[13px] font-bold tracking-widest text-[#061713] transition-transform hover:scale-[1.02] shadow-md uppercase" data-magnetic data-event={`program_cta_${program.slug}`}>
            {isPaa ? "VER PAQUETES" : "Inscríbete ahora"}
          </a>
          <a href={isPaa ? "#contacto" : program.slug === "toefl-ibt" ? "/Diagn%C3%B3stico%20TOEFL%20IBT%20de%20Proacademy.pdf" : "/contacto"} target={program.slug === "toefl-ibt" ? "_blank" : undefined} rel={program.slug === "toefl-ibt" ? "noopener noreferrer" : undefined} class="inline-flex items-center justify-center rounded-full bg-[#121c19] border border-white/10 px-8 py-3.5 font-display text-[13px] font-bold tracking-widest text-pearl transition-colors hover:bg-white/10 uppercase" data-magnetic>
            {isPaa ? "HAZ TU DIAGNÓSTICO GRATIS" : "Diagnóstico gratis"}
          </a>
        </div>
      </div>

      {program.heroImage && (
        <div class:list={[
          "course-hero-image-wrapper pointer-events-none mx-auto mt-12 w-full lg:absolute lg:mx-0 lg:mt-0",
          isPaa
            ? "max-w-xl sm:max-w-2xl lg:right-0 xl:right-4 lg:bottom-0 lg:w-[54%] lg:max-w-[720px] xl:max-w-[760px]"
            : program.slug === 'sat' || program.slug === 'gmat'
              ? "course-hero-image max-w-4xl lg:right-[calc(50%-53vw)] lg:bottom-0 lg:w-[78%] lg:max-w-[1350px]"
              : "course-hero-image max-w-2xl lg:right-[calc(50%-50vw)] lg:bottom-0 lg:w-[65%] lg:max-w-[1100px]"
        ]}>
          {isPaa && (
            <div class="absolute -top-7 -left-7 sm:-top-9 sm:-left-9 lg:-top-11 lg:-left-11 z-20 size-40 sm:size-48 lg:size-52 select-none -rotate-6 filter drop-shadow-[0_14px_26px_rgba(0,0,0,0.55)]">
              <svg viewBox="0 0 200 200" class="size-full font-display" aria-hidden="true">
                <defs>
                  <linearGradient id="paaSealGrad" x1="15%" y1="10%" x2="85%" y2="90%">
                    <stop offset="0%" stop-color="#09695b" />
                    <stop offset="55%" stop-color="#0b7f6e" />
                    <stop offset="100%" stop-color="#0f8d79" />
                  </linearGradient>
                  <path id="paaSealWave" d="M 182.00 100.00 Q 199.10 126.55 171.01 141.00 Q 172.55 172.55 141.00 171.01 Q 126.55 199.10 100.00 182.00 Q 73.45 199.10 59.00 171.01 Q 27.45 172.55 28.99 141.00 Q 0.90 126.55 18.00 100.00 Q 0.90 73.45 28.99 59.00 Q 27.45 27.45 59.00 28.99 Q 73.45 0.90 100.00 18.00 Q 126.55 0.90 141.00 28.99 Q 172.55 27.45 171.01 59.00 Q 199.10 73.45 182.00 100.00 Z" />
                </defs>
                <use href="#paaSealWave" fill="url(#paaSealGrad)" />
                <use href="#paaSealWave" fill="none" stroke="#2dd4bf" stroke-width="1.35" opacity="0.85" transform="translate(100,100) scale(0.87) translate(-100,-100)" />
                <text x="100" y="65" text-anchor="middle" fill="#a7f3d0" font-size="13.5" font-weight="600" letter-spacing="3">GARANTÍA</text>
                <text x="100" y="109" text-anchor="middle" fill="#ffffff" font-size="38" font-weight="800" letter-spacing="-1">+150 <tspan font-size="13.5" font-weight="700" letter-spacing="0" dy="-2">pts</tspan></text>
                <text x="100" y="135" text-anchor="middle" fill="#e6fffb" font-size="9" font-weight="500" opacity="0.95">sobre tu diagnóstico inicial</text>
              </svg>
            </div>
          )}
          <img
            src={program.heroImage.src}
            alt={isPaa ? "Garantía +150 pts sobre tu diagnóstico inicial - Prueba de práctica PAA College Board" : `Plataforma de práctica ${program.exam}`}
            width={program.heroImage.width}
            height={program.heroImage.height}
            loading="eager"
            fetchpriority="high"
            decoding="sync"
            class:list={[
              "w-full drop-shadow-2xl rounded-2xl sm:rounded-3xl",
              !isPaa && "course-hero-image"
            ]}
          />
        </div>
      )}
    </div>
  </section>

  <!-- MÉTRICAS -->
  <section class:list={["hairline-b", isPaa ? "course-metrics-paa" : ""]} aria-label="El programa en números">
    <div class="container-edge grid grid-cols-2 lg:grid-cols-4">
      {stats.map((s, i) => (
        <div class:list={["px-6 py-9", !isPaa && i > 0 && "border-l border-ink-950/8", !isPaa && i >= 2 && "max-lg:border-t max-lg:border-ink-950/8", !isPaa && i === 2 && "max-lg:border-l-0"]} data-reveal>
          <p class="font-display text-4xl font-semibold tracking-tight text-ink-950 sm:text-5xl">
            {s.prefix && <span class={isPaa ? "text-[#00cfab]" : "text-teal-600"}>{s.prefix}</span>}
            {s.text ? (
              <span>{s.text}</span>
            ) : (
              <span data-counter={isDecoupled ? undefined : String(s.value)}>{s.value?.toLocaleString("es-MX")}</span>
            )}
          </p>
          <p class:list={["mt-2 font-mono text-[10px] tracking-[0.18em] uppercase", isPaa ? "text-teal-200/60" : "text-ink-500"]}>{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  {isPaa ? (
    <!-- ======================================================== -->
    <!-- SECUENCIA OFICIAL FIGMA PARA PAA                          -->
    <!-- 1. DOMINA TU EXAMEN PAA (la chica + tabs)                -->
    <!-- 2. PREPARACIÓN ACADÉMICA A TU MEDIDA (4 tarjetas)        -->
    <!-- 3. ENTRENA COMO SI YA FUERA EL DÍA DEL EXAMEN (mockup)   -->
    <!-- 4. LA MEJOR OPCIÓN PARA APROBAR (Precios 3 tarjetas)     -->
    <!-- 5. ELLOS YA LOGRARON SU META (Testimonios PAA)           -->
    <!-- 6. RESOLVEMOS TUS DUDAS (Laptop + FAQs)                  -->
    <!-- ======================================================== -->

    <!-- 1. DOMINA TU EXAMEN PAA, TODAS LAS SECCIONES (oscuro) -->
    <section class="course-sections relative overflow-hidden pt-12 pb-16 hairline-t-dim" style="background-color: rgb(8 13 13)" aria-label="Secciones del examen PAA">
      <div class="pointer-events-none absolute -left-40 top-0 h-[40rem] w-[40rem] rounded-full bg-[#0a1f1c] blur-[60px]" aria-hidden="true"></div>

      <div class="container-edge grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-12 items-end">
        <!-- Columna izquierda: Figura verde orgánica + Chica + Check (Figma) -->
        <div class="relative flex items-end justify-center self-end min-h-[380px] sm:min-h-[460px] lg:min-h-[540px]" data-reveal>
          <!-- Figura orgánica en verde esmeralda oscuro detrás de la chica -->
          <div class="pointer-events-none absolute inset-x-0 bottom-0 top-10 sm:top-14 overflow-hidden rounded-t-[3.5rem] sm:rounded-t-[4.5rem] bg-gradient-to-b from-[#0c2f27] via-[#08201a] to-[#061411] border-t border-l border-teal-400/20 shadow-2xl">
            <svg viewBox="0 0 460 480" class="absolute inset-0 size-full opacity-60" fill="none" preserveAspectRatio="none">
              <path d="M 0 160 C 40 80, 120 10, 240 6 C 360 2, 430 40, 460 70 L 460 480 L 0 480 Z" fill="url(#paaGirlBackdropGrad)" />
              <defs>
                <linearGradient id="paaGirlBackdropGrad" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#144d3f" stop-opacity="0.8" />
                  <stop offset="60%" stop-color="#0a2620" stop-opacity="0.5" />
                  <stop offset="100%" stop-color="#061613" stop-opacity="0.2" />
                </linearGradient>
              </defs>
            </svg>
          </div>

          <!-- Badge flotante check circular verde como en Figma -->
          <div class="absolute left-4 sm:left-8 top-[36%] z-20 size-11 sm:size-12 rounded-full bg-[#00cfab] flex items-center justify-center shadow-[0_0_25px_rgba(0,207,171,0.5)] border border-teal-300/40">
            <Icon name="ph:check" class="size-6 text-white stroke-[3]" />
          </div>

          <!-- Estudiante sentada con tablet -->
          <img
            src={program.skillsImage}
            alt="Estudiante preparándose para la PAA"
            width="812"
            height="745"
            loading="lazy"
            decoding="async"
            class="relative z-10 w-full max-w-[420px] sm:max-w-[480px] lg:max-w-[520px] object-contain object-bottom drop-shadow-xl"
          />
        </div>

        <!-- Columna de Tabs a la derecha -->
        <div class="course-exam-details relative z-10 lg:pt-8 lg:pb-6" data-reveal>
          <h2 class="font-display text-4xl font-semibold leading-[1.05] tracking-tight text-pearl sm:text-5xl">
            Domina tu examen PAA,<br />
            <span class="text-[#00cfab]">todas las secciones.</span>
          </h2>
          <p class="mt-5 max-w-lg text-base leading-relaxed text-ink-300">
            Trabaja las habilidades exactas que evalúa el temario de la PAA, utilizando estrategias prácticas para resolver con precisión y velocidad cada reactivo.
          </p>

          <div class="mt-8" data-exam-tabs>
            <div class="flex gap-1.5 rounded-[2rem] border border-white/5 bg-[#0b1613]/50 p-2" role="tablist" aria-label="Secciones del examen PAA">
              {program.examSections?.map((s, i) => (
                <button
                  type="button"
                  role="tab"
                  class="exam-tab flex flex-1 items-center justify-center gap-2 rounded-full px-2 py-2.5 font-display text-sm font-semibold text-ink-400 transition-all border border-transparent"
                  data-exam-tab
                  data-index={i}
                  id={`exam-tab-paa-${i}`}
                  aria-controls={`exam-panel-paa-${i}`}
                  tabindex={i === 0 ? 0 : -1}
                  aria-selected={i === 0 ? "true" : "false"}
                >
                  <Icon name={examIcons[i] ?? "ph:circle"} class="size-[1.125rem] shrink-0 opacity-70 transition-opacity" aria-hidden="true" />
                  <span>{s.name}</span>
                </button>
              ))}
            </div>

            {program.examSections?.map((s, i) => (
              <div class="exam-panel mt-4 flex min-h-[35rem] flex-col justify-between overflow-hidden rounded-[1.5rem] border border-white/[0.04] bg-transparent backdrop-blur-xl shadow-2xl shadow-black/20 sm:min-h-[32rem]" data-exam-panel data-index={i} id={`exam-panel-paa-${i}`} role="tabpanel" aria-labelledby={`exam-tab-paa-${i}`} tabindex="0" hidden={i !== 0}>
                <!-- Mitad superior azul/turquesa -->
                <div class="flex flex-1 flex-col justify-between bg-[#172c26]/75 p-7 sm:p-8">
                  <div>
                    <h3 class="font-display text-2xl font-semibold tracking-tight text-pearl sm:text-[1.7rem]">
                      {s.name}
                    </h3>
                    <p class="mt-3.5 max-w-2xl text-[15px] leading-relaxed text-pearl/70">{s.description}</p>
                  </div>

                  <div class="mt-8 flex flex-wrap gap-x-12 gap-y-4">
                    <div>
                      <p class="font-mono text-[9px] font-bold tracking-[0.2em] text-pearl/40 uppercase">Tiempo total</p>
                      <p class="mt-1 font-display text-[17px] font-semibold text-pearl">{s.time}</p>
                    </div>
                    <div>
                      <p class="font-mono text-[9px] font-bold tracking-[0.2em] text-pearl/40 uppercase">Puntaje de sección</p>
                      <p class="mt-1 font-display text-[17px] font-semibold text-[#00cfab]">
                        {s.scoreRange} 
                        <span class="text-[13px] font-normal text-pearl/40 ml-1">puntos</span>
                      </p>
                    </div>
                  </div>
                </div>

                <!-- Mitad inferior oscura -->
                <div class="flex flex-1 flex-col justify-center bg-[#121413]/75 p-7 pt-6 sm:px-8 sm:pb-8 sm:pt-7">
                  <div>
                    <p class="font-mono text-[9px] font-bold tracking-[0.2em] text-pearl/40 uppercase">Actividades de la sección</p>
                    <ul class="mt-5 space-y-6">
                      {s.activities.map((a, j) => (
                        <li class="flex gap-4">
                          <span class="grid size-8 shrink-0 place-items-center rounded-full bg-[#1e3c33] font-mono text-[13px] font-semibold text-[#00cfab]">{j + 1}</span>
                          <div class="pt-0.5">
                            <p class="font-display text-[15px] font-semibold tracking-wide text-pearl">{a.title}</p>
                            <p class="mt-1 text-[14px] leading-relaxed text-pearl/60">{a.detail}</p>
                          </div>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 2. PREPARACIÓN ACADÉMICA A TU MEDIDA (blanco) -->
    <section class="course-preparation py-24 bg-white">
      <div class="container-edge">
        <h2 class="text-3xl sm:text-5xl font-display font-semibold tracking-tight text-ink-950" data-reveal>
          Preparación académica <span class="text-[#008f7a]">a tu medida.</span>
        </h2>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-600" data-reveal>{academicIntro}</p>

        <div class="mt-12 grid gap-5 lg:grid-cols-12">
          {program.features.map((f, i) => {
            const isWide = i === 0 || i === program.features.length - 1;
            const img = i === 0 ? program.guideImage : i === program.features.length - 1 ? program.guaranteeImage : undefined;
            return (
              <div class:list={[
                "relative flex flex-col justify-center overflow-hidden rounded-3xl border border-ink-950/[0.04] p-7 sm:p-8 min-h-[190px]",
                isPaa ? "bg-[#ebedec]" : "bg-ink-50 border-ink-950/[0.06]",
                isWide ? "lg:col-span-8" : "lg:col-span-4"
              ]} data-reveal>
                <div class:list={["relative z-10", isWide ? "max-w-xs sm:max-w-sm lg:max-w-[19rem] xl:max-w-[21rem]" : "max-w-full"]}>
                  <div class="flex items-center gap-4">
                    <span class="grid size-12 shrink-0 place-items-center rounded-full bg-[#008f7a] text-white shadow-sm">
                      <Icon name={featureIcons[i] ?? "ph:check"} class="size-6 text-white" aria-hidden="true" />
                    </span>
                    <h3 class="font-display text-xl sm:text-[1.28rem] font-semibold tracking-tight text-ink-950">{f.title}</h3>
                  </div>
                  <p class="mt-3.5 text-[14px] sm:text-[15px] leading-relaxed text-ink-600">{f.detail}</p>
                </div>
                {img && (
                  <img
                    src={img}
                    alt={f.title}
                    width={i === 0 ? "800" : "944"}
                    height={i === 0 ? "977" : "740"}
                    loading="lazy"
                    decoding="async"
                    class:list={[
                      "pointer-events-none absolute object-contain transition-opacity drop-shadow-md",
                      i === 0
                        ? "right-4 sm:right-10 -bottom-10 sm:-bottom-12 w-40 sm:w-48 lg:w-[220px]"
                        : "right-3 sm:right-6 bottom-0 w-44 sm:w-52 lg:w-[250px]"
                    ]}
                    aria-hidden="true"
                  />
                )}
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- 3. ENTRENA COMO SI YA FUERA EL DÍA DEL EXAMEN (oscuro) -->
    <section class="relative overflow-hidden py-24 hairline-t-dim hairline-b-dim" style="background-color: rgb(8 16 14)" aria-label="Plataforma de simulación PAA">
      <div class="pointer-events-none absolute -left-24 top-1/2 -translate-y-1/2 h-[42rem] w-[62rem] rounded-[50%] bg-[#0c2b24]/45 blur-[2px] -rotate-12" aria-hidden="true"></div>
      <div class="pointer-events-none absolute right-0 top-1/2 -translate-y-1/2 h-[38rem] w-[38rem] rounded-full bg-teal-600/10 blur-[130px]" aria-hidden="true"></div>

      <div class="container-edge relative grid items-center gap-12 lg:grid-cols-[1.02fr_0.98fr] lg:gap-16">
        <div data-reveal>
          <h2 class="font-display text-[clamp(2.15rem,4vw,3.25rem)] font-semibold leading-[1.08] tracking-tight text-pearl">
            Entrena como si ya<br />
            fuera <span class="text-[#00cfab]">el día del examen.</span>
          </h2>

          <p class="mt-5 max-w-xl text-[16px] sm:text-[17px] leading-relaxed text-ink-300">
            Nuestra plataforma replica el nivel, formato y presión de tiempo de la PAA para convertir cada práctica en una ventaja real.
          </p>

          <ul class="mt-8 divide-y divide-white/10 border-t border-white/10">
            <li class="flex items-start gap-4 py-5">
