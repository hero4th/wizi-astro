---
import { Icon } from "astro-icon/components";
import Base from "@/layouts/Base.astro";
import FAQList from "@/components/FAQList.astro";
import { PROGRAMS } from "@/data/programs";
import { SITE } from "@/data/site";
import { breadcrumbSchema, courseSchema, faqSchema } from "@/lib/schema";

export function getStaticPaths() {
  return PROGRAMS.map((program) => ({
    params: { slug: program.slug },
    props: { program },
  }));
}

const { program } = Astro.props;

const priceFormatted = new Intl.NumberFormat("es-MX", {
  style: "currency",
  currency: "MXN",
  maximumFractionDigits: 0,
}).format(program.priceMXN);

const stats = [
  { value: program.sessions, label: "sesiones de clase" },
  { value: program.exercises, label: "ejercicios prácticos", prefix: "+" },
  { value: program.evaluations, label: "evaluaciones completas" },
  { value: program.hours, label: "horas grabadas en HD", prefix: "+" },
];

const comparison = [
  { label: "Precio total", pa: priceFormatted, trad: "Hasta $30,000", good: true },
  { label: "Modelo de clase", pa: "1 a 1 personalizado", trad: "Grupos de 10 o más", good: true },
  { label: "Preguntas de práctica", pa: `Más de ${program.exercises.toLocaleString("es-MX")}`, trad: "Material limitado", good: true },
  { label: "Simuladores idénticos al examen", pa: "Incluidos", trad: "No incluidos", good: true },
  { label: "Garantía de puntaje", pa: "Por contrato", trad: "Sin garantía", good: true },
];

const schema = [
  courseSchema(program),
  faqSchema(program.faqs),
  breadcrumbSchema([
    { name: "Inicio", url: SITE.url },
    { name: "Cursos", url: `${SITE.url}/cursos` },
    { name: program.exam, url: `${SITE.url}/cursos/${program.slug}` },
  ]),
];
---

<Base title={program.metaTitle} description={program.metaDescription} schema={schema}>
  <!-- HERO -->
  <section class="relative overflow-hidden pt-36 pb-20" data-parallax-root>
    <div class="pointer-events-none absolute -right-40 top-0 h-[28rem] w-[28rem] rounded-full bg-teal-500/10 blur-[130px]" data-parallax="-80" aria-hidden="true"></div>

    <div class="container-edge relative grid items-end gap-14 lg:grid-cols-[1.5fr_1fr]">
      <div>
        <nav aria-label="Ruta de navegación" class="font-mono text-[11px] tracking-[0.18em] text-ink-400 uppercase">
          <a href="/" class="transition-colors hover:text-teal-300">Inicio</a>
          <span aria-hidden="true"> / </span>
          <a href="/cursos" class="transition-colors hover:text-teal-300">Cursos</a>
          <span aria-hidden="true"> / </span>
          <span class="text-teal-400">{program.exam}</span>
        </nav>

        <h1 class="mt-7 max-w-2xl font-display text-[clamp(2.5rem,6vw,4.75rem)] leading-[1.04] font-semibold tracking-[-0.03em]" data-reveal-line>
          <span class="line-mask"><span class="line-inner">{program.headline}</span></span>
          <span class="line-mask"><span class="line-inner"><em class="accent-em">{program.accent}</em></span></span>
        </h1>

        <p class="mt-7 max-w-xl text-lg leading-relaxed text-pearl-dim" data-reveal>
          {program.subheadline}
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-4" data-reveal>
          <a href="/contacto" class="btn-primary" data-magnetic data-event={`program_cta_${program.slug}`}>
            Evaluación gratis
          </a>
          <p class="text-sm text-ink-300">
            Desde <strong class="font-display text-lg text-pearl">{priceFormatted}</strong> MXN
            <span class="block font-mono text-[10px] tracking-widest text-ink-400 uppercase">pagos a meses disponibles</span>
          </p>
        </div>
      </div>

      <!-- Panel de garantía -->
      <div class="glass rounded-2xl p-7 shadow-panel" data-reveal data-reveal-delay="0.15">
        <p class="flex items-center gap-2 font-mono text-[11px] tracking-[0.2em] text-teal-400 uppercase">
          <Icon name="ph:seal-check" class="size-4" aria-hidden="true" />
          Garantía de Puntaje
        </p>
        <p class="mt-4 text-[15px] leading-relaxed text-pearl">{program.guarantee}</p>
        <p class="mt-5 hairline-t pt-5 text-sm leading-relaxed text-ink-300">
          {program.audience}
        </p>
        <p class="mt-4 font-mono text-[11px] tracking-widest text-ink-400 uppercase">
          Escala del examen: {program.scoreScale}
        </p>
      </div>
    </div>
  </section>

  <!-- MÉTRICAS DEL PROGRAMA -->
  <section class="hairline-t hairline-b" aria-label="El programa en números">
    <div class="container-edge grid grid-cols-2 lg:grid-cols-4">
      {stats.map((s, i) => (
        <div class:list={["px-6 py-9", i > 0 && "border-l border-pearl/8", i >= 2 && "max-lg:border-t max-lg:border-pearl/8", i === 2 && "max-lg:border-l-0"]} data-reveal data-reveal-delay={String(i * 0.06)}>
          <p class="font-display text-4xl font-semibold tracking-tight sm:text-5xl">
            {s.prefix && <span class="text-teal-400">{s.prefix}</span>}<span data-counter={String(s.value)}>0</span>
          </p>
          <p class="mt-2 font-mono text-[10px] tracking-[0.18em] text-ink-300 uppercase">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- PILARES (bento asimétrico) -->
  <section class="py-24">
    <div class="container-edge">
      <h2 class="max-w-2xl text-3xl sm:text-5xl" data-reveal>
        Un plan de estudios <em class="accent-em">a tu medida.</em>
      </h2>

      <div class="mt-12 grid gap-5 md:grid-cols-3">
        <div class="relative overflow-hidden rounded-2xl hairline bg-ink-900 p-8 md:col-span-2" data-reveal>
          <div class="pointer-events-none absolute -top-20 right-0 h-56 w-56 rounded-full bg-teal-500/10 blur-[80px]" aria-hidden="true"></div>
          <h3 class="font-display text-2xl font-semibold tracking-tight">{program.features[0]!.title}</h3>
          <p class="mt-3 max-w-md text-[15px] leading-relaxed text-ink-300">{program.features[0]!.detail}</p>
          <p class="mt-8 inline-block rounded-full bg-teal-400/10 px-4 py-2 font-mono text-[11px] tracking-widest text-teal-300 uppercase">
            Incluido en tu plan
          </p>
        </div>
        <div class="rounded-2xl hairline bg-teal-900/40 p-8" data-reveal data-reveal-delay="0.08">
          <h3 class="font-display text-2xl font-semibold tracking-tight">{program.features[1]!.title}</h3>
          <p class="mt-3 text-[15px] leading-relaxed text-pearl-dim">{program.features[1]!.detail}</p>
        </div>
        <div class="rounded-2xl hairline bg-ink-900 p-8" data-reveal>
          <h3 class="font-display text-2xl font-semibold tracking-tight">{program.features[2]!.title}</h3>
          <p class="mt-3 text-[15px] leading-relaxed text-ink-300">{program.features[2]!.detail}</p>
        </div>
        <div class="relative overflow-hidden rounded-2xl hairline bg-ink-900 p-8 md:col-span-2" data-reveal data-reveal-delay="0.08">
          <h3 class="font-display text-2xl font-semibold tracking-tight">{program.features[3]!.title}</h3>
          <p class="mt-3 max-w-md text-[15px] leading-relaxed text-ink-300">{program.features[3]!.detail}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIONES DEL EXAMEN -->
  <section class="py-24 hairline-t">
    <div class="container-edge grid gap-14 lg:grid-cols-[1fr_1.5fr]">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <p class="eyebrow" data-reveal>Temario {program.exam}</p>
        <h2 class="mt-4 text-3xl sm:text-4xl" data-reveal>Domina cada sección.</h2>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-ink-300" data-reveal>
          Cada sección del examen es una habilidad distinta. Tu plan ataca las
          cuatro con un enfoque y ejercicios específicos.
        </p>
      </div>
      <div data-reveal>
        <div class="hairline-t">
          {program.skills.map((skill) => (
            <details class="faq-item group hairline-b" name={`skills-${program.slug}`}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 transition-colors hover:text-teal-300">
                <span class="font-display text-xl font-medium tracking-tight">{skill.name}</span>
                <span class="faq-icon grid size-9 shrink-0 place-items-center rounded-full hairline" aria-hidden="true">
                  <svg class="size-3.5" viewBox="0 0 14 14" fill="none">
                    <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  </svg>
                </span>
              </summary>
              <p class="max-w-2xl pb-7 text-[15px] leading-relaxed text-ink-300">{skill.detail}</p>
            </details>
          ))}
        </div>

        <ul class="mt-10 grid gap-3 sm:grid-cols-2">
          {program.outcomes.map((outcome) => (
            <li class="flex items-start gap-3 rounded-xl hairline bg-ink-900 px-5 py-4 text-sm text-pearl-dim">
              <Icon name="ph:check" class="mt-0.5 size-4 shrink-0 text-teal-400" aria-hidden="true" />
              {outcome}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- COMPARATIVA -->
  <section class="py-24 hairline-t">
    <div class="container-edge">
      <h2 class="max-w-2xl text-3xl sm:text-4xl" data-reveal>
        Compara antes de decidir.
      </h2>
      <div class="mt-12 overflow-x-auto" data-reveal>
        <table class="w-full min-w-[36rem] border-collapse text-left">
          <caption class="sr-only">Comparación entre Professional Academy y la preparación tradicional</caption>
          <thead>
            <tr class="hairline-b">
              <th scope="col" class="py-4 pr-6 font-mono text-[11px] tracking-[0.18em] text-ink-400 uppercase">Concepto</th>
              <th scope="col" class="bg-teal-400/5 px-6 py-4 font-mono text-[11px] tracking-[0.18em] text-teal-300 uppercase">Professional Academy</th>
              <th scope="col" class="px-6 py-4 font-mono text-[11px] tracking-[0.18em] text-ink-400 uppercase">Preparación tradicional</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr class="hairline-b">
                <th scope="row" class="py-5 pr-6 text-sm font-normal text-ink-300">{row.label}</th>
                <td class="bg-teal-400/5 px-6 py-5 text-[15px] font-medium text-pearl">{row.pa}</td>
                <td class="px-6 py-5 text-sm text-ink-400">{row.trad}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-24 hairline-t" aria-label={`Preguntas frecuentes sobre el curso ${program.exam}`}>
    <div class="container-edge grid gap-14 lg:grid-cols-[1fr_1.6fr]">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <h2 class="text-3xl sm:text-4xl" data-reveal>
          Preguntas sobre<br />el curso {program.exam}.
        </h2>
      </div>
      <div data-reveal>
        <FAQList faqs={program.faqs} name={`faq-${program.slug}`} />
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative overflow-hidden py-28 hairline-t">
    <div class="pointer-events-none absolute left-1/2 top-1/2 h-[30rem] w-[30rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-teal-500/10 blur-[140px]" aria-hidden="true"></div>
    <div class="container-edge relative text-center">
      <h2 class="mx-auto max-w-3xl text-3xl sm:text-5xl" data-reveal>
        Tu preparación {program.exam} comienza<br />
        <em class="accent-em">con una sesión gratuita.</em>
      </h2>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4" data-reveal>
        <a href="/contacto" class="btn-primary" data-magnetic data-event={`program_final_cta_${program.slug}`}>
          Evaluación gratis
        </a>
        <a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener noreferrer" class="btn-ghost" data-magnetic>
          Hablar por WhatsApp
        </a>
      </div>
    </div>
  </section>
</Base>
