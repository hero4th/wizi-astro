---
export const prerender = false;

import Base from "@/layouts/Base.astro";
import { getPublishedPosts, getBlogCategories } from "@/lib/blog";
import { SITE } from "@/data/site";
import { breadcrumbSchema } from "@/lib/schema";

const posts = await getPublishedPosts();
const activeCategories = await getBlogCategories(posts);

const [featured, ...rest] = posts;
const fullFmt = new Intl.DateTimeFormat("es-MX", { day: "numeric", month: "long", year: "numeric" });
const shortFmt = new Intl.DateTimeFormat("es-MX", { day: "numeric", month: "short", year: "numeric" });
---

<Base
  title="Blog de preparación académica | Professional Academy"
  description="Guías de TOEFL, SAT, GRE, GMAT y PAA, técnicas de estudio, procesos de admisión y recursos gratuitos, escritos por nuestros tutores expertos."
  schema={[breadcrumbSchema([
    { name: "Inicio", url: SITE.url },
    { name: "Blog", url: `${SITE.url}/blog` },
  ])]}
>
  <!-- Page header -->
  <section class="pt-36 pb-12">
    <div class="container-edge">
      <p class="eyebrow" data-reveal>Blog</p>
      <h1
        class="mt-4 max-w-3xl font-display text-[clamp(2.5rem,6vw,4.5rem)] leading-[1.04] font-semibold tracking-[-0.03em]"
        data-reveal-line
      >
        <span class="line-mask"><span class="line-inner">Estudia con</span></span>
        <span class="line-mask"><span class="line-inner"><em class="accent-em">método.</em></span></span>
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-500" data-reveal>
        Guías, estrategias y recursos escritos por los mismos tutores que
        preparan a nuestros alumnos.
      </p>

      <nav class="mt-10 flex flex-wrap gap-2" aria-label="Categorías del blog" data-reveal>
        {activeCategories.map((cat) => (
          <a
            href={`/blog/categoria/${cat.slug}`}
            class="rounded-full hairline px-4 py-2 font-mono text-[11px] tracking-[0.12em] text-ink-500 uppercase transition-colors hover:border-teal-500 hover:text-teal-600"
          >
            {cat.name}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- Featured article -->
  {featured && (
    <section class="pb-12" aria-label="Artículo destacado">
      <div class="container-edge">
        <a
          href={`/blog/${featured.id}`}
          class="group relative block overflow-hidden rounded-3xl border border-pearl/10 transition-all duration-500 hover:border-teal-500/40 hover:shadow-[0_20px_60px_-15px_rgb(20_184_166/0.22)] hover:-translate-y-1"
          style="background-color: rgb(10 16 16)"
          data-reveal
        >
          <!-- Decorative ambient halo -->
          <div class="pointer-events-none absolute -right-32 -top-32 h-96 w-96 rounded-full bg-teal-500/12 blur-[120px] transition-opacity duration-500 group-hover:opacity-100" aria-hidden="true"></div>
          <div class="relative grid gap-8 p-6 sm:p-8 lg:grid-cols-12 lg:items-center lg:gap-10 lg:p-10 z-10">
            <!-- Text Column -->
            <div class="flex flex-col justify-between lg:col-span-7">
              <div>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-teal-500/15 border border-teal-500/25 px-3.5 py-1 font-mono text-[10.5px] font-medium tracking-[0.16em] text-teal-400 uppercase">
                  <span class="size-1.5 rounded-full bg-teal-400 animate-pulse"></span>
                  Destacado · {featured.data.category}
                </span>
                <h2 class="mt-5 max-w-2xl font-display text-2xl sm:text-3xl lg:text-4xl xl:text-[2.65rem] leading-[1.12] font-semibold tracking-tight text-balance text-pearl transition-colors duration-300 group-hover:text-teal-400">
                  {featured.data.title}
                </h2>
                <p class="mt-4 max-w-xl text-base leading-relaxed text-ink-300">
                  {featured.data.description}
                </p>
              </div>
              <div class="mt-8 lg:mt-10 flex flex-wrap items-center gap-5">
                <span class="btn-primary !px-7 !py-3.5 !font-display !text-xs sm:!text-sm !font-bold !tracking-widest !text-ink-950 shadow-glow">
                  LEER ARTÍCULO
                  <svg class="ml-2 inline size-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M1 7h12m0 0L8 2m5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <div class="flex flex-wrap items-center gap-4 font-mono text-[11px] text-ink-400">
                  <time datetime={featured.data.pubDate.toISOString()} class="flex items-center gap-1.5 text-ink-300">
                    <svg class="size-3.5 text-ink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                    </svg>
                    {fullFmt.format(featured.data.pubDate)}
                  </time>
                  <span class="flex items-center gap-1.5 text-teal-400 font-medium">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                    </svg>
                    {featured.data.readingTime} min lectura
                  </span>
                </div>
              </div>
            </div>
            <!-- Featured Image Column -->
            <div class="lg:col-span-5">
              <div class="relative aspect-[16/10] w-full overflow-hidden rounded-2xl bg-ink-900 shadow-2xl ring-1 ring-pearl/10">
                {featured.data.image ? (
                  <img src={featured.data.image} alt="" class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" />
                ) : (
                  <div class="relative flex h-full w-full flex-col items-center justify-center gap-4 bg-teal-500/10 p-8">
                    <span class="font-display text-4xl font-bold tracking-tighter text-teal-400/30 select-none">
                      {featured.data.category.toUpperCase()}
                    </span>
                  </div>
                )}
              </div>
            </div>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- Post grid -->
  {rest.length > 0 && (
    <section class="pb-28 pt-6" aria-label="Todos los artículos">
      <div class="container-edge">
        <h2 class="mb-8 font-mono text-[11px] tracking-[0.2em] text-ink-400 uppercase" data-reveal>
          Más artículos
        </h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {rest.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="blog-card group flex flex-col overflow-hidden rounded-2xl hairline bg-white transition-all duration-300 hover:shadow-[0_12px_36px_-8px_rgb(20_184_166/0.18)] hover:border-teal-500/40 hover:-translate-y-1.5"
            >
              <!-- Featured image or accent band -->
              {post.data.image ? (
                <div class="h-44 w-full overflow-hidden bg-ink-100">
                  <img src={post.data.image} alt="" loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" />
                </div>
              ) : (
                <div class="h-1.5 w-full bg-gradient-to-r from-teal-400 to-teal-500"></div>
              )}
              <!-- Content -->
              <div class="flex flex-1 flex-col p-6">
                <div class="flex items-center justify-between gap-2">
                  <span class="inline-flex items-center rounded-md bg-teal-500/10 px-2.5 py-0.5 font-mono text-[10px] font-medium tracking-[0.15em] text-teal-700 uppercase">
                    {post.data.category}
                  </span>
                  <time datetime={post.data.pubDate.toISOString()} class="flex items-center gap-1.5 font-mono text-[10.5px] text-ink-400">
                    <svg class="size-3.5 text-ink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                    </svg>
                    {shortFmt.format(post.data.pubDate)}
                  </time>
                </div>
                <h3 class="mt-3.5 font-display text-xl leading-snug font-semibold tracking-tight text-ink-950 transition-colors duration-200 group-hover:text-teal-700">
                  {post.data.title}
                </h3>
                <p class="mt-2.5 line-clamp-2 flex-1 text-sm leading-relaxed text-ink-500">
                  {post.data.description}
                </p>
                <div class="mt-5 flex items-center justify-between pt-4 border-t border-ink-950/5">
                  <span class="font-mono text-[11px] font-medium text-ink-500 group-hover:text-teal-700 transition-colors">
                    Leer artículo
                  </span>
                  <span class="flex items-center gap-1.5 font-mono text-[11px] font-medium text-ink-400 transition-colors group-hover:text-teal-700">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                    </svg>
                    {post.data.readingTime} min
                    <svg class="ml-0.5 size-3.5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                      <path d="M1 7h12m0 0L8 2m5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!reducedMotion) {
      const cards = gsap.utils.toArray<HTMLElement>(".blog-card");

      ScrollTrigger.batch(cards, {
        start: "top 93%",
        onEnter: (batch) => {
          gsap.fromTo(
            batch,
            { y: 16 },
            {
              y: 0,
              duration: 0.65,
              stagger: 0,
              ease: "power2.out",
              overwrite: "auto",
              onComplete: () => {
                gsap.set(batch, { clearProps: "opacity,transform" });
              },
            }
          );
        },
        once: true,
      });

      window.addEventListener("load", () => {
        ScrollTrigger.refresh();
      });
    }
  </script>
</Base>
