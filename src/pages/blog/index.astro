---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import { CATEGORIES } from "@/data/categories";
import { SITE } from "@/data/site";
import { breadcrumbSchema } from "@/lib/schema";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const activeCategories = CATEGORIES.filter((c) =>
  posts.some((p) => p.data.categorySlug === c.slug)
);

const [featured, ...rest] = posts;
const fullFmt = new Intl.DateTimeFormat("es-MX", { day: "numeric", month: "long", year: "numeric" });
const shortFmt = new Intl.DateTimeFormat("es-MX", { day: "numeric", month: "short", year: "numeric" });

const READ_TIME = 5;
---

<Base
  title="Blog de preparación académica | Professional Academy"
  description="Guías de TOEFL, SAT, GRE, GMAT y PAA, técnicas de estudio, procesos de admisión y recursos gratuitos, escritos por nuestros tutores expertos."
  schema={[breadcrumbSchema([
    { name: "Inicio", url: SITE.url },
    { name: "Blog", url: `${SITE.url}/blog` },
  ])]}
>
  <!-- Page header -->
  <section class="pt-36 pb-12">
    <div class="container-edge">
      <p class="eyebrow" data-reveal>Blog</p>
      <h1
        class="mt-4 max-w-3xl font-display text-[clamp(2.5rem,6vw,4.5rem)] leading-[1.04] font-semibold tracking-[-0.03em]"
        data-reveal-line
      >
        <span class="line-mask"><span class="line-inner">Estudia con</span></span>
        <span class="line-mask"><span class="line-inner"><em class="accent-em">método.</em></span></span>
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-500" data-reveal>
        Guías, estrategias y recursos escritos por los mismos tutores que
        preparan a nuestros alumnos.
      </p>

      <nav class="mt-10 flex flex-wrap gap-2" aria-label="Categorías del blog" data-reveal>
        {activeCategories.map((cat) => (
          <a
            href={`/blog/categoria/${cat.slug}`}
            class="rounded-full hairline px-4 py-2 font-mono text-[11px] tracking-[0.12em] text-ink-500 uppercase transition-colors hover:border-teal-500 hover:text-teal-600"
          >
            {cat.label}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- Featured article -->
  {featured && (
    <section class="pb-8" aria-label="Artículo destacado">
      <div class="container-edge">
        <a
          href={`/blog/${featured.id}`}
          class="group relative block overflow-hidden rounded-3xl bg-teal-500/8 transition-all duration-500 hover:bg-teal-500/14"
          data-reveal
        >
          <div class="grid lg:grid-cols-[1fr_280px] xl:grid-cols-[1fr_340px]">
            <!-- Text -->
            <div class="p-8 sm:p-12 lg:p-14">
              <p class="font-mono text-[11px] tracking-[0.2em] text-teal-600 uppercase">
                Destacado · {featured.data.category}
              </p>
              <h2 class="mt-5 max-w-2xl font-display text-[clamp(1.75rem,3.5vw,2.75rem)] leading-tight font-semibold tracking-tight text-balance text-ink-950">
                {featured.data.title}
              </h2>
              <p class="mt-4 max-w-xl text-base leading-relaxed text-ink-500">
                {featured.data.description}
              </p>
              <div class="mt-10 flex flex-wrap items-center gap-5">
                <span class="btn-ghost !px-6 !py-3 !text-[11.5px] group-hover:border-teal-500 group-hover:text-teal-600">
                  Leer artículo
                  <svg class="ml-2 inline size-3.5 transition-transform duration-300 group-hover:translate-x-0.5" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M1 7h12m0 0L8 2m5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="font-mono text-[11px] text-ink-400">
                  <time datetime={featured.data.pubDate.toISOString()}>{fullFmt.format(featured.data.pubDate)}</time>
                  {" · "}{READ_TIME} min lectura
                </span>
              </div>
            </div>
            <!-- Decorative panel -->
            <div class="hidden items-center justify-center bg-teal-400/12 lg:flex" aria-hidden="true">
              <div class="relative flex flex-col items-center gap-4 p-8">
                <span class="font-display text-[7rem] font-bold leading-none tracking-tighter text-teal-400/30 select-none">
                  {featured.data.category.replace(/\s.*/,"").toUpperCase()}
                </span>
                <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-teal-500/10 rounded-xl"></div>
              </div>
            </div>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- Post grid -->
  {rest.length > 0 && (
    <section class="pb-28 pt-6" aria-label="Todos los artículos">
      <div class="container-edge">
        <h2 class="mb-8 font-mono text-[11px] tracking-[0.2em] text-ink-400 uppercase" data-reveal>
          Más artículos
        </h2>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {rest.map((post, i) => (
            <a
              href={`/blog/${post.id}`}
              class="group flex flex-col overflow-hidden rounded-2xl hairline bg-white transition-all duration-300 hover:shadow-[0_4px_24px_-6px_rgb(0_0_0/0.10)] hover:-translate-y-0.5"
              data-reveal
              data-reveal-delay={String((i % 3) * 0.06)}
            >
              <!-- Accent band -->
              <div class="h-1 w-full bg-teal-400/70"></div>
              <!-- Content -->
              <div class="flex flex-1 flex-col p-6">
                <p class="font-mono text-[10px] tracking-[0.2em] text-teal-600 uppercase">
                  {post.data.category}
                </p>
                <h3 class="mt-3 font-display text-xl leading-snug font-semibold tracking-tight text-ink-950 transition-colors group-hover:text-teal-600">
                  {post.data.title}
                </h3>
                <p class="mt-2.5 line-clamp-2 flex-1 text-sm leading-relaxed text-ink-500">
                  {post.data.description}
                </p>
                <div class="mt-5 flex items-center justify-between">
                  <time datetime={post.data.pubDate.toISOString()} class="font-mono text-[10.5px] text-ink-400">
                    {shortFmt.format(post.data.pubDate)}
                  </time>
                  <span class="flex items-center gap-1 font-mono text-[10.5px] text-ink-400 transition-colors group-hover:text-teal-600">
                    {READ_TIME} min
                    <svg class="size-3 transition-transform duration-300 group-hover:translate-x-0.5" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                      <path d="M1 6h10m0 0L7 2m4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>
