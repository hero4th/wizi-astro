---
import { getCollection, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import { SITE } from "@/data/site";
import { articleSchema, breadcrumbSchema } from "@/lib/schema";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const url = `${SITE.url}/blog/${post.id}`;
const formatter = new Intl.DateTimeFormat("es-MX", { day: "numeric", month: "long", year: "numeric" });
const shortFmt = new Intl.DateTimeFormat("es-MX", { day: "numeric", month: "short", year: "numeric" });
const readTime = post.data.readingTime;

const related = (await getCollection("blog", ({ data, id }) => !data.draft && id !== post.id))
  .filter((p) => p.data.categories.some((c) => post.data.categories.some((pc) => pc.slug === c.slug)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const schema = [
  articleSchema({
    title: post.data.title,
    description: post.data.description,
    url,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: post.data.updatedDate?.toISOString(),
  }),
  breadcrumbSchema([
    { name: "Inicio", url: SITE.url },
    { name: "Blog", url: `${SITE.url}/blog` },
    { name: post.data.title, url },
  ]),
];
---

<Base title={`${post.data.title} | Professional Academy`} description={post.data.description} schema={schema} ogType="article" ogImage={post.data.image}>
  <article class="pt-36 pb-28">
    <div class="container-edge">

      <!-- Top Header Section (Full Width / Centered) -->
      <div class="mx-auto max-w-3xl flex flex-col items-center text-center">
        <!-- Breadcrumb -->
        <nav aria-label="Ruta de navegación" class="font-mono text-[11px] tracking-[0.18em] text-ink-400 uppercase">
          <a href="/blog" class="transition-colors hover:text-teal-600">Blog</a>
          <span aria-hidden="true" class="mx-2 opacity-40">/</span>
          <a href={`/blog/categoria/${post.data.categorySlug}`} class="text-teal-600 transition-colors hover:text-teal-700">
            {post.data.category}
          </a>
        </nav>

        <!-- Article header -->
        <header class="mt-6">
          <h1 class="font-display text-[clamp(1.875rem,4vw,3rem)] leading-tight font-semibold tracking-tight text-balance text-ink-950">
            {post.data.title}
          </h1>
          <div class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2.5 text-[13px] font-medium text-ink-500">
            <span class="flex items-center gap-1.5">
              <svg class="size-4 text-ink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
              </svg>
              Por {post.data.author}
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="size-4 text-ink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
              <time datetime={post.data.pubDate.toISOString()}>Fecha de publicación: {formatter.format(post.data.pubDate)}</time>
            </span>
            {post.data.updatedDate && (
              <span class="flex items-center gap-1.5">
                <svg class="size-4 text-ink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 2v6h-6"/><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                </svg>
                Actualizado: {formatter.format(post.data.updatedDate)}
              </span>
            )}
            <span class="flex items-center gap-1.5 font-semibold text-teal-600">
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
              {readTime} min de lectura
            </span>
          </div>
          <p class="mt-6 text-lg leading-relaxed text-ink-500 text-balance">{post.data.description}</p>
        </header>

        <!-- Featured Image -->
        {post.data.image && (
          <div class="mt-10 w-full overflow-hidden rounded-2xl bg-teal-500/8">
            <img
              src={post.data.image}
              alt={post.data.imageAlt}
              width={post.data.imageWidth ?? 1200}
              height={post.data.imageHeight ?? 630}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="w-full h-[240px] sm:h-[320px] md:h-[400px] object-cover"
            />
          </div>
        )}
      </div>

      <!-- Split Layout Section -->
      <div class="mx-auto mt-16 max-w-[1024px] lg:flex lg:gap-12 xl:gap-16">

        <!-- Sidebar -->
        <aside class="hidden lg:block lg:w-[240px] shrink-0">
          <div class="sticky top-32">
            <TableOfContents headings={headings} />
          </div>
        </aside>

        <!-- Main Content -->
        <div class="min-w-0 flex-1 max-w-2xl mx-auto lg:mx-0">

          <!-- Prose content -->
          <div class="prose-pa">
            <Content />
          </div>

          <!-- Inline CTA (dark) -->
          <aside
            class="relative mt-16 overflow-hidden rounded-2xl hairline-dim"
            style="background-color: rgb(6 10 10)"
            aria-label="Agenda tu evaluación"
          >
            <div class="pointer-events-none absolute -right-20 -top-16 h-64 w-64 rounded-full bg-teal-600/15 blur-[90px]" aria-hidden="true"></div>
            <div class="relative p-8 sm:p-10">
              <h2 class="font-display text-2xl font-semibold tracking-tight text-pearl">
                ¿Quieres saber tu puntaje actual?
              </h2>
              <p class="mt-3 text-[15px] leading-relaxed text-ink-300">
                Tu primera evaluación diagnóstica es gratuita: mide tu nivel real y
                recibe un plan de preparación a tu medida.
              </p>
              <a href="/contacto" class="btn-primary mt-7 inline-flex" data-event="blog_inline_cta">
                Evaluación gratis
              </a>
            </div>
          </aside>

          <!-- Related posts -->
          {related.length > 0 && (
            <section class="mt-20" aria-label="Artículos relacionados">
              <h2 class="font-mono text-[11px] tracking-[0.2em] text-ink-400 uppercase">
                Sigue leyendo
              </h2>
              <div class="mt-6 grid gap-4 sm:grid-cols-2">
                {related.map((p) => (
                  <a
                    href={`/blog/${p.id}`}
                    class="group flex flex-col overflow-hidden rounded-xl hairline bg-white transition-all duration-300 hover:shadow-[0_4px_20px_-6px_rgb(0_0_0/0.10)] hover:-translate-y-0.5"
                  >
                    {p.data.image ? (
                      <div class="h-36 w-full overflow-hidden bg-ink-100">
                        <img src={p.data.image} alt="" loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                      </div>
                    ) : (
                      <div class="h-1 w-full bg-teal-400/60"></div>
                    )}
                    <div class="flex flex-1 flex-col p-5">
                      <p class="font-mono text-[10px] tracking-[0.2em] text-teal-600 uppercase">
                        {p.data.category}
                      </p>
                      <h3 class="mt-2.5 font-display text-lg leading-snug font-semibold tracking-tight text-ink-950 transition-colors group-hover:text-teal-600">
                        {p.data.title}
                      </h3>
                      <div class="mt-4 flex items-center justify-between font-mono text-[10.5px] text-ink-400">
                        <time datetime={p.data.pubDate.toISOString()} class="flex items-center gap-1.5">
                          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                          </svg>
                          {shortFmt.format(p.data.pubDate)}
                        </time>
                        <span class="flex items-center gap-1.5 transition-colors group-hover:text-teal-600">
                          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                          </svg>
                          {p.data.readingTime} min
                        </span>
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </section>
          )}

        </div>
      </div>

    </div>
  </article>
</Base>
