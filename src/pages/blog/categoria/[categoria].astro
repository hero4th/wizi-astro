---
export const prerender = false;

import Base from "@/layouts/Base.astro";
import { getPublishedPosts, getBlogCategories, getPostsByCategory } from "@/lib/blog";
import { SITE } from "@/data/site";
import { breadcrumbSchema } from "@/lib/schema";

const allPosts = await getPublishedPosts();
const categories = await getBlogCategories(allPosts);
const category = categories.find((c) => c.slug === Astro.params.categoria);
if (!category) return Astro.rewrite("/404");

const posts = await getPostsByCategory(category.slug, allPosts);
const formatter = new Intl.DateTimeFormat("es-MX", { day: "numeric", month: "long", year: "numeric" });

Astro.response.headers.set("Content-Type", "text/html; charset=utf-8");
---

<Base
  title={`${category.name}: artículos y guías | Blog Professional Academy`}
  description={category.description}
  schema={[breadcrumbSchema([
    { name: "Inicio", url: SITE.url },
    { name: "Blog", url: `${SITE.url}/blog` },
    { name: category.name, url: `${SITE.url}/blog/categoria/${category.slug}` },
  ])]}
>
  <section class="pt-36 pb-12">
    <div class="container-edge">
      <nav aria-label="Ruta de navegación" class="font-mono text-[11px] tracking-[0.18em] text-ink-400 uppercase">
        <a href="/blog" class="transition-colors hover:text-teal-600">Blog</a>
        <span aria-hidden="true"> / </span>
        <span class="text-teal-400">{category.name}</span>
      </nav>
      <h1 class="mt-6 max-w-3xl font-display text-4xl leading-tight font-semibold tracking-tight sm:text-6xl">
        {category.name}
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-500">{category.description}</p>
    </div>
  </section>

  <section class="pb-24">
    <div class="container-edge">
      {posts.length === 0 ? (
        <div class="rounded-2xl hairline px-8 py-16 text-center">
          <p class="font-display text-2xl font-semibold tracking-tight text-ink-950">Aún no hay artículos en esta categoría.</p>
          <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-ink-500">
            Estamos escribiendo nuevas guías. Mientras tanto, explora el resto del blog
            o pregúntanos directamente lo que necesitas saber.
          </p>
          <div class="mt-8 flex flex-wrap justify-center gap-4">
            <a href="/blog" class="btn-ghost !px-5 !py-2.5 !text-[11px]">Ver todos los artículos</a>
            <a href="/contacto" class="btn-primary !px-5 !py-2.5 !text-[11px]">Evaluación gratis</a>
          </div>
        </div>
      ) : (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="blog-card group flex flex-col overflow-hidden rounded-2xl hairline bg-white transition-all duration-300 hover:shadow-[0_12px_36px_-8px_rgb(20_184_166/0.18)] hover:border-teal-500/40 hover:-translate-y-1.5"
            >
              {post.data.image ? (
                <div class="h-44 w-full overflow-hidden bg-ink-100">
                  <img src={post.data.image} alt="" loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" />
                </div>
              ) : (
                <div class="h-1.5 w-full bg-gradient-to-r from-teal-400 to-teal-500"></div>
              )}
              <div class="flex flex-1 flex-col p-6">
                <div class="flex items-center justify-between gap-2">
                  <span class="inline-flex items-center rounded-md bg-teal-500/10 px-2.5 py-0.5 font-mono text-[10px] font-medium tracking-[0.15em] text-teal-700 uppercase">
                    {post.data.category}
                  </span>
                  <time datetime={post.data.pubDate.toISOString()} class="flex items-center gap-1.5 font-mono text-[10.5px] text-ink-400">
                    <svg class="size-3.5 text-ink-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                    </svg>
                    {formatter.format(post.data.pubDate)}
                  </time>
                </div>
                <h2 class="mt-3.5 font-display text-xl leading-snug font-semibold tracking-tight text-ink-950 transition-colors duration-200 group-hover:text-teal-700">
                  {post.data.title}
                </h2>
                <p class="mt-2.5 line-clamp-2 flex-1 text-sm leading-relaxed text-ink-500">{post.data.description}</p>
                <div class="mt-5 flex items-center justify-between pt-4 border-t border-ink-950/5">
                  <span class="font-mono text-[11px] font-medium text-ink-500 group-hover:text-teal-700 transition-colors">
                    Leer artículo
                  </span>
                  <span class="flex items-center gap-1.5 font-mono text-[11px] font-medium text-ink-400 transition-colors group-hover:text-teal-700">
                    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                    </svg>
                    {post.data.readingTime} min
                    <svg class="ml-0.5 size-3.5 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                      <path d="M1 7h12m0 0L8 2m5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!reducedMotion) {
      const cards = gsap.utils.toArray<HTMLElement>(".blog-card");

      ScrollTrigger.batch(cards, {
        start: "top 93%",
        onEnter: (batch) => {
          gsap.fromTo(
            batch,
            { y: 16 },
            {
              y: 0,
              duration: 0.65,
              stagger: 0,
              ease: "power2.out",
              overwrite: "auto",
              onComplete: () => {
                gsap.set(batch, { clearProps: "opacity,transform" });
              },
            }
          );
        },
        once: true,
      });

      window.addEventListener("load", () => {
        ScrollTrigger.refresh();
      });
    }
  </script>
</Base>
