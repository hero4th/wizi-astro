---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import { CATEGORIES } from "@/data/categories";
import { SITE } from "@/data/site";
import { breadcrumbSchema } from "@/lib/schema";

export async function getStaticPaths() {
  return CATEGORIES.map((category) => ({
    params: { categoria: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;

const posts = (await getCollection("blog", ({ data }) => !data.draft && data.categorySlug === category.slug))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatter = new Intl.DateTimeFormat("es-MX", { day: "numeric", month: "long", year: "numeric" });
---

<Base
  title={`${category.label}: artículos y guías | Blog Professional Academy`}
  description={category.description}
  schema={[breadcrumbSchema([
    { name: "Inicio", url: SITE.url },
    { name: "Blog", url: `${SITE.url}/blog` },
    { name: category.label, url: `${SITE.url}/blog/categoria/${category.slug}` },
  ])]}
>
  <section class="pt-36 pb-12">
    <div class="container-edge">
      <nav aria-label="Ruta de navegación" class="font-mono text-[11px] tracking-[0.18em] text-ink-400 uppercase">
        <a href="/blog" class="transition-colors hover:text-teal-600">Blog</a>
        <span aria-hidden="true"> / </span>
        <span class="text-teal-400">{category.label}</span>
      </nav>
      <h1 class="mt-6 max-w-3xl font-display text-4xl leading-tight font-semibold tracking-tight sm:text-6xl">
        {category.label}
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-500">{category.description}</p>
    </div>
  </section>

  <section class="pb-24">
    <div class="container-edge">
      {posts.length === 0 ? (
        <div class="rounded-2xl hairline px-8 py-16 text-center">
          <p class="font-display text-2xl font-semibold tracking-tight text-ink-950">Aún no hay artículos en esta categoría.</p>
          <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-ink-500">
            Estamos escribiendo nuevas guías. Mientras tanto, explora el resto del blog
            o pregúntanos directamente lo que necesitas saber.
          </p>
          <div class="mt-8 flex flex-wrap justify-center gap-4">
            <a href="/blog" class="btn-ghost !px-5 !py-2.5 !text-[11px]">Ver todos los artículos</a>
            <a href="/contacto" class="btn-primary !px-5 !py-2.5 !text-[11px]">Evaluación gratis</a>
          </div>
        </div>
      ) : (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post, i) => (
            <a
              href={`/blog/${post.id}`}
              class="group flex flex-col overflow-hidden rounded-2xl hairline bg-white transition-all duration-300 hover:shadow-[0_4px_24px_-6px_rgb(0_0_0/0.10)] hover:-translate-y-0.5"
              data-reveal
              data-reveal-delay={String((i % 3) * 0.06)}
            >
              <div class="h-1 w-full bg-teal-400/70"></div>
              <div class="flex flex-1 flex-col p-6">
                <p class="font-mono text-[10px] tracking-[0.2em] text-teal-600 uppercase">{post.data.category}</p>
                <h2 class="mt-3 font-display text-xl leading-snug font-semibold tracking-tight text-ink-950 transition-colors group-hover:text-teal-600">
                  {post.data.title}
                </h2>
                <p class="mt-2.5 line-clamp-2 flex-1 text-sm leading-relaxed text-ink-500">{post.data.description}</p>
                <div class="mt-5 flex items-center justify-between">
                  <time datetime={post.data.pubDate.toISOString()} class="font-mono text-[10.5px] text-ink-400">
                    {formatter.format(post.data.pubDate)}
                  </time>
                  <span class="font-mono text-[10.5px] text-ink-400 transition-colors group-hover:text-teal-600">5 min →</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>
