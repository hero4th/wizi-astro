---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import { CATEGORIES } from "@/data/categories";
import { SITE } from "@/data/site";
import { breadcrumbSchema } from "@/lib/schema";

export async function getStaticPaths() {
  return CATEGORIES.map((category) => ({
    params: { categoria: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;

const posts = (await getCollection("blog", ({ data }) => !data.draft && data.categorySlug === category.slug))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatter = new Intl.DateTimeFormat("es-MX", { day: "numeric", month: "long", year: "numeric" });
---

<Base
  title={`${category.label}: artículos y guías | Blog Professional Academy`}
  description={category.description}
  schema={[breadcrumbSchema([
    { name: "Inicio", url: SITE.url },
    { name: "Blog", url: `${SITE.url}/blog` },
    { name: category.label, url: `${SITE.url}/blog/categoria/${category.slug}` },
  ])]}
>
  <section class="pt-36 pb-12">
    <div class="container-edge">
      <nav aria-label="Ruta de navegación" class="font-mono text-[11px] tracking-[0.18em] text-ink-400 uppercase">
        <a href="/blog" class="transition-colors hover:text-teal-300">Blog</a>
        <span aria-hidden="true"> / </span>
        <span class="text-teal-400">{category.label}</span>
      </nav>
      <h1 class="mt-6 max-w-3xl font-display text-4xl leading-tight font-semibold tracking-tight sm:text-6xl">
        {category.label}
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-pearl-dim">{category.description}</p>
    </div>
  </section>

  <section class="pb-24">
    <div class="container-edge">
      {posts.length === 0 ? (
        <div class="rounded-2xl hairline bg-ink-900 px-8 py-16 text-center">
          <p class="font-display text-2xl font-semibold tracking-tight">Aún no hay artículos en esta categoría.</p>
          <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-ink-300">
            Estamos escribiendo nuevas guías. Mientras tanto, explora el resto del blog
            o pregúntanos directamente lo que necesitas saber.
          </p>
          <div class="mt-8 flex flex-wrap justify-center gap-4">
            <a href="/blog" class="btn-ghost !px-5 !py-2.5 !text-[11px]">Ver todos los artículos</a>
            <a href="/contacto" class="btn-primary !px-5 !py-2.5 !text-[11px]">Evaluación gratis</a>
          </div>
        </div>
      ) : (
        <div class="grid gap-px overflow-hidden rounded-2xl hairline bg-pearl/8 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <a href={`/blog/${post.id}`} class="group flex flex-col justify-between bg-ink-950 p-8 transition-colors duration-500 hover:bg-ink-900">
              <div>
                <h2 class="font-display text-xl leading-snug font-semibold tracking-tight transition-colors group-hover:text-teal-300">
                  {post.data.title}
                </h2>
                <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-ink-300">{post.data.description}</p>
              </div>
              <time datetime={post.data.pubDate.toISOString()} class="mt-8 font-mono text-[11px] text-ink-400">
                {formatter.format(post.data.pubDate)}
              </time>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>
