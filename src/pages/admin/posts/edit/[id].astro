---
export const prerender = false;

import AdminLayout from "@/layouts/AdminLayout.astro";
import PostEditor from "@/components/admin/PostEditor";
import { getSessionUser, hasPermission } from "@/lib/auth";
import { PERMISSIONS } from "@/lib/permissions";
import { sql } from "@/lib/db";

const user = await getSessionUser(Astro.cookies);
if (!user) return Astro.redirect("/admin/login", 303);
if (!hasPermission(user, PERMISSIONS.POSTS_UPDATE)) {
  return Astro.redirect("/admin/sin-acceso", 303);
}

const id = Number(Astro.params.id);
const rows = await sql`SELECT * FROM posts WHERE id = ${id}`;
const post = rows[0];
if (!post) return Astro.redirect("/admin", 303);

const pubDate = new Date(post.pub_date).toISOString().slice(0, 10);

const initial = {
  id: post.id,
  title: post.title,
  slug: post.slug,
  description: post.description,
  category: post.category,
  categorySlug: post.category_slug,
  pubDate,
  author: post.author,
  image: post.image ?? "",
  imageAlt: post.image_alt ?? "",
  draft: post.draft,
  html: post.html,
  seoTitle: post.seo_title ?? "",
  seoDescription: post.seo_description ?? "",
  canonicalUrl: post.canonical_url ?? "",
  noindex: post.noindex ?? false,
  ogImage: post.og_image ?? "",
  keywords: post.keywords ?? "",
};
---

<AdminLayout title={`Editar: ${post.title}`} fullBleed>
  <PostEditor client:load isNew={false} initial={initial} />
</AdminLayout>
