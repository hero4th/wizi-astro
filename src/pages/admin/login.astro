---
export const prerender = false;

import { requireSession } from "@/lib/auth";

// Already logged in? Skip the form.
if (await requireSession(Astro.cookies)) {
  return Astro.redirect("/admin", 303);
}

const error = Astro.url.searchParams.get("error") === "1";
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Iniciar sesión | Blog Admin</title>
    <style>
      :root { color-scheme: light; }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #f4f7f6;
      }
      form {
        width: 100%;
        max-width: 320px;
        background: #fff;
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
      }
      h1 { font-size: 1.15rem; margin: 0 0 1.5rem; color: #0f172a; }
      label { display: block; font-size: 0.8rem; font-weight: 600; color: #475569; margin-bottom: 0.4rem; }
      input {
        width: 100%;
        box-sizing: border-box;
        padding: 0.65rem 0.8rem;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 0.95rem;
      }
      input:focus { outline: 2px solid #0d9488; outline-offset: 1px; border-color: #0d9488; }
      button {
        width: 100%;
        margin-top: 1.25rem;
        padding: 0.7rem;
        border: 0;
        border-radius: 8px;
        background: #0d9488;
        color: #fff;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
      }
      button:hover { background: #0f766e; }
      .error {
        margin: 0 0 1rem;
        padding: 0.65rem 0.8rem;
        background: #fef2f2;
        color: #b91c1c;
        border-radius: 8px;
        font-size: 0.85rem;
      }
    </style>
  </head>
  <body>
    <form id="login-form">
      <h1>Blog Admin — Professional Academy</h1>
      <p class="error" id="error-box" hidden={!error}>Contraseña incorrecta.</p>
      <label for="password">Contraseña</label>
      <input id="password" name="password" type="password" required autofocus autocomplete="current-password" />
      <button type="submit">Entrar</button>
    </form>

    <script>
      // A native <form method="POST"> submission carries
      // Content-Type: application/x-www-form-urlencoded, which trips Astro's
      // built-in CSRF check (security.checkOrigin) on Vercel — its Origin
      // detection doesn't line up with Vercel's proxying. Submitting as JSON
      // instead (same pattern the rest of the admin panel already uses)
      // sidesteps that check entirely.
      const form = document.getElementById("login-form") as HTMLFormElement;
      const errorBox = document.getElementById("error-box") as HTMLElement;

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorBox.hidden = true;

        const password = (document.getElementById("password") as HTMLInputElement).value;
        const res = await fetch("/api/admin/login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ password }),
        });

        if (res.redirected) {
          window.location.href = res.url;
        } else if (res.status === 429) {
          errorBox.textContent = "Demasiados intentos. Espera 15 minutos.";
          errorBox.hidden = false;
        } else {
          errorBox.textContent = "Contraseña incorrecta.";
          errorBox.hidden = false;
        }
      });
    </script>
  </body>
</html>
